{% set currentUrl = page.url or '/' %}
<!DOCTYPE html>
<html data-lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title_en or title_zh or 'Untitled Page' }}</title>
  <link rel="icon" type="image/png" href="/uploads/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- ========= 第一層導覽 ========= -->
  <nav class="navbar">
    <div class="lang-toggle">
      <button class="lang-btn" data-lang-toggle="zh">中文</button> |
      <button class="lang-btn" data-lang-toggle="en">EN</button>
    </div>
    <div class="navbar-right">
      <a class="lang-en" href="/core/">Core</a>
      <a class="lang-en" href="/projects/">Projects</a>
      <a class="lang-en" href="/about/">About</a>
      <a class="lang-zh" href="/core/">核心</a>
      <a class="lang-zh" href="/projects/">項目</a>
      <a class="lang-zh" href="/about/">關於</a>
    </div>
  </nav>

  <!-- ========= 第二層導覽 ========= -->
  {% if currentUrl == "/projects/" %}
    {% include "subnav-projects.njk" %}
  {% elif currentUrl == "/core/" or currentUrl == "/about/" %}
    {% include "subnav-keywords.njk" %}
  {% endif %}

  <!-- ========= 版身 ========= -->
  <div class="container">
    {% block content %}{{ content | safe }}{% endblock %}
  </div>

  <!-- ========= Scripts ========= -->
  <script>
    // ✅ 語言切換
    function setLang(lang) {
      localStorage.setItem('lang', lang);
      document.documentElement.setAttribute('data-lang', lang);
      document.querySelectorAll('[data-lang-toggle]').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-lang-toggle') === lang);
      });
    }

    document.addEventListener("DOMContentLoaded", function () {
      const savedLang = localStorage.getItem('lang') || 'zh';
      setLang(savedLang);
      document.querySelectorAll('[data-lang-toggle]').forEach(btn => {
        btn.addEventListener('click', () => setLang(btn.getAttribute('data-lang-toggle') || 'zh'));
      });

      // ✅ mobile drawer 開關
      const drawer = document.getElementById("typeDrawer");
      const backdrop = document.getElementById("typeBackdrop");
      const openBtn = document.getElementById("typeToggleMobile");
      const closeBtn = document.getElementById("typeDrawerClose");

      if (openBtn && drawer && backdrop) {
        openBtn.addEventListener("click", () => {
          drawer.classList.add("is-open");
          backdrop.classList.add("is-open");
        });
        closeBtn.addEventListener("click", () => {
          drawer.classList.remove("is-open");
          backdrop.classList.remove("is-open");
        });
        backdrop.addEventListener("click", () => {
          drawer.classList.remove("is-open");
          backdrop.classList.remove("is-open");
        });
      }

      // ✅ sort toggle（遞增 / 遞減）
      const sortBtn = document.getElementById("sortToggle");
      if (sortBtn) {
        sortBtn.addEventListener("click", () => {
          const current = sortBtn.dataset.order || "desc";
          const next = current === "desc" ? "asc" : "desc";

          const url = new URL(window.location.href);
          url.searchParams.set("sort", next);
          window.location.href = url.toString();
        });
      }
    });
  </script>
  <script>
// ======== 篩選功能（僅限 /projects/ 頁面）========
document.addEventListener("DOMContentLoaded", function () {
  if (!location.pathname.startsWith("/projects")) return;

  const projects = Array.from(document.querySelectorAll(".project"));
  const chips = document.querySelectorAll(".chip");
  const typeChips = document.querySelectorAll(".type-chip");
  const regionChips = document.querySelectorAll(".region-chip");
  const sortBtn = document.getElementById("sortToggle");
  let selectedTypes = new Set();
  let selectedRegions = new Set();
  let sortDesc = true;

  function updateProjects() {
    projects.forEach(p => {
      const type = p.getAttribute("data-type");
      const region = p.getAttribute("data-region");

      const typeMatch = selectedTypes.size === 0 || selectedTypes.has(type);
      const regionMatch = selectedRegions.size === 0 || selectedRegions.has(region);

      p.style.display = (typeMatch && regionMatch) ? "" : "none";
    });

    // 排序
    const list = document.querySelector(".projects-grid");
    const sorted = projects.sort((a, b) => {
      const ya = parseInt(a.getAttribute("data-year")) || 0;
      const yb = parseInt(b.getAttribute("data-year")) || 0;
      return sortDesc ? yb - ya : ya - yb;
    });
    sorted.forEach(p => list.appendChild(p));
  }

  // 類型篩選
  typeChips.forEach(chip => {
    chip.addEventListener("click", () => {
      const type = chip.getAttribute("data-type");
      if (type === "ALL") {
        selectedTypes.clear();
      } else {
        if (selectedTypes.has(type)) {
          selectedTypes.delete(type);
        } else {
          selectedTypes.add(type);
        }
      }

      // Active 樣式更新
      typeChips.forEach(c => c.classList.remove("active"));
      if (selectedTypes.size === 0) {
        document.querySelectorAll(".type-chip[data-type='ALL']").forEach(c => c.classList.add("active"));
      } else {
        typeChips.forEach(c => {
          const t = c.getAttribute("data-type");
          if (selectedTypes.has(t)) c.classList.add("active");
        });
      }

      updateProjects();
    });
  });

  // 地區篩選
  regionChips.forEach(chip => {
    chip.addEventListener("click", () => {
      const region = chip.getAttribute("data-region");
      if (region === "all") {
        selectedRegions.clear();
      } else {
        if (selectedRegions.has(region)) {
          selectedRegions.delete(region);
        } else {
          selectedRegions.add(region);
        }
      }

      regionChips.forEach(c => c.classList.remove("active"));
      if (selectedRegions.size === 0) {
        document.querySelectorAll(".region-chip[data-region='all']").forEach(c => c.classList.add("active"));
      } else {
        regionChips.forEach(c => {
          const r = c.getAttribute("data-region");
          if (selectedRegions.has(r)) c.classList.add("active");
        });
      }

      updateProjects();
    });
  });

  // 排序按鈕
  if (sortBtn) {
    sortBtn.addEventListener("click", () => {
      sortDesc = !sortDesc;
      sortBtn.dataset.order = sortDesc ? "desc" : "asc";
      document.getElementById("sortArrow").textContent = sortDesc ? "↓" : "↑";
      updateProjects();
    });
  }

  // 預設啟用
  updateProjects();
});
</script>
</body>
</html>
