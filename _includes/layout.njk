{% set currentUrl = page.url or '/' %}
<!DOCTYPE html>
<html data-lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title_en or title_zh or 'Untitled Page' }}</title>
  <link rel="icon" type="image/png" href="/uploads/favicon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- ========= 第一層導覽 ========= -->
  <nav class="navbar">
    <div class="lang-toggle">
      <button class="lang-btn" data-lang-toggle="zh">中文</button> |
      <button class="lang-btn" data-lang-toggle="en">EN</button>
    </div>
    <div class="navbar-right">
      <a class="lang-en" href="/core/">Core</a>
      <a class="lang-en" href="/projects/">Projects</a>
      <a class="lang-en" href="/about/">About</a>
      <a class="lang-zh" href="/core/">核心</a>
      <a class="lang-zh" href="/projects/">項目</a>
      <a class="lang-zh" href="/about/">關於</a>
    </div>
  </nav>

  <!-- ========= 第二層導覽 ========= -->
  {% set currentPath = page.url | url or '' %}
  {% if currentPath.indexOf("/projects/") === 0 or currentPath == "/about/" %}
    {% include "subnav-projects.njk" %}
  {% elif currentPath == "/core/" %}
    {% include "subnav-keywords.njk" %}
  {% endif %}

  <!-- ========= 版身 ========= -->
  <div class="container">
    {% block content %}{{ content | safe }}{% endblock %}
  </div>
  <!-- ========= Scripts ========= -->
  <script>
    function setLang(lang) {
      localStorage.setItem('lang', lang);
      document.documentElement.setAttribute('data-lang', lang);
      document.querySelectorAll('[data-lang-toggle]').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-lang-toggle') === lang);
      });
    }

    document.addEventListener("DOMContentLoaded", function () {
      const savedLang = localStorage.getItem('lang') || 'zh';
      setLang(savedLang);
      document.querySelectorAll('[data-lang-toggle]').forEach(btn => {
        btn.addEventListener('click', () => setLang(btn.getAttribute('data-lang-toggle') || 'zh'));
      });

      // ✅ drawer 開關（通用 keyword 用）
      const drawer = document.getElementById("keywordDrawer");
      const backdrop = document.getElementById("keywordBackdrop");
      const openBtn = document.getElementById("keywordToggleMobile");
      const closeBtn = document.getElementById("keywordDrawerClose");

      if (openBtn && drawer && backdrop) {
        openBtn.addEventListener("click", () => {
          drawer.classList.add("is-open");
          backdrop.classList.add("is-open");
        });
        closeBtn?.addEventListener("click", () => {
          drawer.classList.remove("is-open");
          backdrop.classList.remove("is-open");
        });
        backdrop?.addEventListener("click", () => {
          drawer.classList.remove("is-open");
          backdrop.classList.remove("is-open");
        });
      }

      // ✅ keywords 篩選與排序（core 頁用）
      if (location.pathname.startsWith("/core")) {
        const items = document.querySelectorAll(".corepage");
        const keywordChips = document.querySelectorAll(".keyword-chip");
        const sortToggle = document.getElementById("sortToggle");
        const sortArrow = document.getElementById("sortArrow");

        let selectedKeywords = new Set();
        let sortDescending = true;

        function filterAndSort() {
          const container = document.querySelector(".projects-grid");
          const visibleItems = [];

          items.forEach(item => {
            const keywords = (item.dataset.keywords || "").split(",").map(s => s.trim());
            const match = selectedKeywords.size === 0 || [...selectedKeywords].every(k => keywords.includes(k));
            item.style.display = match ? "" : "none";
            if (match) visibleItems.push(item);
          });

          visibleItems.sort((a, b) => {
            const ya = parseInt(a.dataset.year) || 0;
            const yb = parseInt(b.dataset.year) || 0;
            return sortDescending ? yb - ya : ya - yb;
          });

          visibleItems.forEach(item => container.appendChild(item));
        }

        keywordChips.forEach(chip => {
          chip.addEventListener("click", () => {
            const keyword = chip.dataset.keyword;

            if (keyword === "ALL") {
              selectedKeywords.clear();
            } else {
              selectedKeywords.delete("ALL");
              if (selectedKeywords.has(keyword)) {
                selectedKeywords.delete(keyword);
              } else {
                selectedKeywords.add(keyword);
              }
            }

            keywordChips.forEach(c => {
              const k = c.dataset.keyword;
              if (selectedKeywords.size === 0) {
                c.classList.toggle("active", k === "ALL");
              } else {
                c.classList.toggle("active", selectedKeywords.has(k));
              }
            });

            filterAndSort();
          });
        });

        sortToggle?.addEventListener("click", () => {
          sortDescending = !sortDescending;
          sortArrow.textContent = sortDescending ? "↓" : "↑";
          sortToggle.dataset.order = sortDescending ? "desc" : "asc";
          filterAndSort();
        });

        filterAndSort();
      }

      // ✅ projects 或 about 頁面（type/region chips 可導向 projects 篩選）
      if (location.pathname.startsWith("/projects") || location.pathname.startsWith("/about")) {
        const onProjectsPage = location.pathname.startsWith("/projects");
        const projects = document.querySelectorAll(".project");
        const typeChips = document.querySelectorAll(".type-chip");
        const regionChips = document.querySelectorAll(".region-chip");
        const sortToggle = document.getElementById("sortToggle");
        const sortArrow = document.getElementById("sortArrow");

        let selectedTypes = new Set(["ALL"]);
        let selectedRegions = new Set(["all"]);
        let sortDescending = true;

        function filterProjects() {
          if (!onProjectsPage) return;
          projects.forEach(p => {
            const type = p.dataset.type;
            const region = p.dataset.region;
            const typeMatch = selectedTypes.has("ALL") || selectedTypes.has(type);
            const regionMatch = selectedRegions.has("all") || selectedRegions.has(region);
            p.style.display = (typeMatch && regionMatch) ? "" : "none";
          });
        }

        function sortProjects() {
          if (!onProjectsPage) return;
          const container = document.querySelector(".projects-grid");
          const items = Array.from(projects).filter(p => p.style.display !== "none");

          items.sort((a, b) => {
            const ya = parseInt(a.dataset.year) || 0;
            const yb = parseInt(b.dataset.year) || 0;
            return sortDescending ? yb - ya : ya - yb;
          });

          items.forEach(item => container.appendChild(item));
        }

        // ✅ 點選 chip 如果在 about 頁面 → 轉址
        function redirectToProjectsWith(type, region) {
          const url = new URL(window.location.origin + "/projects/");
          if (type) url.searchParams.set("type", type);
          if (region) url.searchParams.set("region", region);
          window.location.href = url.toString();
        }

        typeChips.forEach(chip => {
          chip.addEventListener("click", () => {
            const value = chip.dataset.type;

            // ✅ 若非 /projects 頁面，導回並附上篩選參數
              if (!location.pathname.startsWith("/projects")) {
                const url = new URL("/projects/", location.origin);
                url.searchParams.set("type", value);
                location.href = url.href;
                return;
              }

            if (!onProjectsPage) return redirectToProjectsWith(value, [...selectedRegions][0]);

            if (value === "ALL") {
              selectedTypes = new Set(["ALL"]);
            } else {
              if (selectedTypes.has("ALL")) selectedTypes.delete("ALL");
              if (selectedTypes.has(value)) selectedTypes.delete(value);
              else selectedTypes.add(value);
              if (selectedTypes.size === 0) selectedTypes.add("ALL");
            }

            typeChips.forEach(c => {
              const v = c.dataset.type;
              c.classList.toggle("active", selectedTypes.has(v));
            });

            filterProjects();
            sortProjects();
          });
        });

        // ✅ region 單選
        regionChips.forEach(chip => {
          chip.addEventListener("click", () => {
            const value = chip.dataset.region;

            // ✅ 若非 /projects 頁面，導回並附上篩選參數
            if (!location.pathname.startsWith("/projects")) {
              const url = new URL("/projects/", location.origin);
              url.searchParams.set("region", value);
              location.href = url.href;
              return;
            }


            if (!onProjectsPage) return redirectToProjectsWith([...selectedTypes][0], value);

            selectedRegions = new Set([value]);
            regionChips.forEach(c => {
              const v = c.dataset.region;
              c.classList.toggle("active", v === value);
            });

            filterProjects();
            sortProjects();
          });
        });

        sortToggle?.addEventListener("click", () => {
          sortDescending = !sortDescending;
          sortArrow.textContent = sortDescending ? "↓" : "↑";
          sortToggle.dataset.order = sortDescending ? "desc" : "asc";
          sortProjects();
        });

        // ✅ drawer 開關（type 用）
        const typeDrawer = document.getElementById("typeDrawer");
        const typeBackdrop = document.getElementById("typeBackdrop");
        const typeToggleBtn = document.getElementById("typeToggleMobile");
        const typeCloseBtn = document.getElementById("typeDrawerClose");

        if (typeDrawer && typeBackdrop && typeToggleBtn && typeCloseBtn) {
          typeToggleBtn.addEventListener("click", () => {
            typeDrawer.classList.add("is-open");
            typeBackdrop.classList.add("is-open");
          });
          typeCloseBtn.addEventListener("click", () => {
            typeDrawer.classList.remove("is-open");
            typeBackdrop.classList.remove("is-open");
          });
          typeBackdrop.addEventListener("click", () => {
            typeDrawer.classList.remove("is-open");
            typeBackdrop.classList.remove("is-open");
          });
        }

        // 初始化（projects 頁才需要）
        if (onProjectsPage) {
          // ✅ 根據 URL 查詢參數初始化
          const urlParams = new URLSearchParams(location.search);
          const initType = urlParams.get("type");
          const initRegion = urlParams.get("region");
          if (initType) selectedTypes = new Set([initType]);
          if (initRegion) selectedRegions = new Set([initRegion]);

          typeChips.forEach(c => {
            if (selectedTypes.has(c.dataset.type)) c.classList.add("active");
          });
          regionChips.forEach(c => {
            if (selectedRegions.has(c.dataset.region)) c.classList.add("active");
          });

          filterProjects();
          sortProjects();
        }
      }
    });
  </script>
</body>
</html>
