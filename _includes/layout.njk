<!DOCTYPE html>
<html data-lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title_en or title_zh or 'Untitled Page' }}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/uploads/favicon.png">
  <link rel="shortcut icon" type="image/png" href="/uploads/favicon.png">
  <link rel="icon" type="image/png" href="/uploads/favicon.png?v=2">

  <style>
    /* =========================
     * 全域基礎（不碰 .project*）
     * =======================*/
    :root{
      --nav-h: 64px;                  /* 第一層 navbar 高度 */
      --subnav-h: 64px;               /* 第二層 subnav 高度（桌機/手機都鎖定） */
      --container-w: 1000px;          /* 版身寬度上限 */
      --drawer-w: 24vw;               /* 手機抽屜寬度（相對視窗） */
      --drawer-w-max: 320px;          /* 手機抽屜最大寬度 */
    }

    html[data-lang='en'] .lang-zh { display: none !important; }
    html[data-lang='zh'] .lang-en { display: none !important; }

    body{
      font-family: sans-serif;
      margin: 0;
      padding: 0;
      color: #111;
      background: #fff;
    }

    .container{
      max-width: var(--container-w);
      margin: 2em auto;
      padding: 1em;
    }

    /* =========================
     * 第一層 Navbar（僅控制導覽列）
     * =======================*/
    .navbar{
      position: sticky; top: 0; z-index: 20;
      display: flex; align-items: center; justify-content: space-between;
      height: var(--nav-h);
      padding: 0 2em;
      background: #fff; border-bottom: 1px solid #ddd;
    }
    .navbar-right a{
      margin-left: 1em; color: #000; font-size: 1.1em; font-weight: bold;
      text-decoration: none; transition: color .2s ease;
    }
    .navbar-right a:hover{ color: #333; }

    .lang-toggle{ display: flex; align-items: center; gap: 6px; font-size: .9rem; }
    .lang-btn{
      padding: 2px 4px; background: none; border: none; color: gray; font-weight: normal;
      cursor: pointer; transition: color .2s ease;
    }
    .lang-btn.active{ color: #000; font-weight: bold; }
    .lang-btn:hover{ color: #333; }

    /* =========================
     * 第二層 Subnav（Type / Region / Sort）
     * =======================*/
    .subnav{
      position: sticky; top: var(--nav-h); z-index: 15;
      background: #fff; border-bottom: 1px solid #eee;
      height: var(--subnav-h);             /* 固定高度 */
      min-height: var(--subnav-h);
      display: flex; align-items: center;  /* 內容垂直置中 */
      overflow: hidden;                    /* 禁止內容撐高 */
    }
    .subnav-inner{
      max-width: var(--container-w);
      margin: 0 auto;
      padding: .6em 1em;
      width: 100%;
      display: grid;

      /* 桌機：加大 Type 欄位，避免換行擠壓右側 */
      grid-template-columns:
        minmax(0, 1.6fr)   /* Type */
        minmax(0, 0.5fr)   /* Region */
        minmax(0, 0.4fr);  /* Sort */
      column-gap: 1.25em;

      align-items: center;     /* 垂直置中在 64px 內 */
      justify-items: start;    /* 內容靠左 */
      justify-content: start;  /* 整個 grid 靠左 */
    }
    .subnav-inner > *{ min-width: 0; } /* 允許欄位縮，避免把後兩欄擠走 */

    .chip-title{
      display: block; font-size: .8em; color: #666; line-height: 1.2;
      margin-bottom: .2em;
    }
    .chip-bar{ display: flex; flex-wrap: wrap; gap: .5em; align-items: center; }
    .chip{
      padding: 0; background: none; border: none; color: #555; cursor: pointer;
      font: inherit; text-decoration: none; border-bottom: 1px solid transparent;
      transition: color .2s, border-color .2s; font-size: .9em;
    }
    .chip:hover{ color: #000; }
    .chip.active{ color: #000; border-bottom-color: #000; }

    /* -------- Type：桌機單列，不換行（溢出隱藏，避免增加高度） -------- */
    .type-group{ position: relative; }
    .type-inline{
      display: flex; flex-wrap: nowrap; gap: .5em; align-items: center;
      overflow: hidden;       /* 多的隱藏，不會撐到右邊去 */
      min-width: 0;
    }
    /* 「Type: / 類型：」置前，chips 接在後面（同一行） */
    .type-inline .chip-title{ margin: 0 .4em 0 0; }

    .type-toggle-mobile{ display: none; } /* 僅手機顯示 */
    .type-mobile{ display: none; }        /* 僅手機顯示 */

    /* -------- Region：桌機單列，不換行（同樣溢出隱藏） -------- */
    .region-group{ justify-self: start; }
    .region-bar{
      display: flex; flex-wrap: nowrap; gap: .5em; align-items: center;
      overflow: hidden;
    }

    /* -------- Sort -------- */
    .sort-group{
      display: flex; flex-direction: column; align-items: flex-start; justify-self: start;
    }
    .sort-toggle{
      margin-top: .1em; background: none; border: none; cursor: pointer; font: inherit; color: #333;
      border-bottom: 1px solid transparent; padding: 0; line-height: 1; font-size: .9em;
    }
    .sort-toggle:hover{ border-bottom-color:#333; }
    #sortArrow{ display: inline-block; }

    /* =========================
     * 手機（≤900px）
     * - Subnav 仍固定 64px 高
     * - Type 變成小按鈕 → 左側窄抽屜
     * - Region 放中間給更多寬度
     * =======================*/
     @media (max-width: 900px){
       /* 1) 三欄一律頂端對齊，不要置中 */
       .subnav-inner{
         grid-template-columns: auto 1fr auto;  /* [Type 按鈕][Region][Sort] */
         align-items: start;                     /* ← 改這個 */
       }

       /* 2) 顯示手機版 Type，隱藏桌機 chips */
       .type-inline{ display: none; }
       .type-mobile{
         display: flex;
         flex-direction: column;
         align-items: flex-start;
         /* 同 Region 的垂直間距由下面兩行控制 */
       }
       .type-mobile .chip-title{
         margin: 0;               /* 跟 Region 一樣，標題本身不加底 margin */
         line-height: 1.2;
         font-size: .8em;
       }
       .type-toggle-mobile{
         display: inline-flex;
         align-items: center;
         gap: .4em;
         background: none;
         border: 0;               /* 不要透明底線，避免多出 1px 高度 */
         padding: 0;
         color: #333;
         font: inherit;
         white-space: nowrap;
         cursor: pointer;
         margin-top: .25em;       /* ← 與 Region 的 .region-bar 上緣距一致 */
       }

       /* 3) 讓 Region 跟 Type 的結構一致：標題無 margin，內容用上邊距撐開 */
       .region-group{
         display: flex;           /* 跟 .type-mobile 一樣，用 column */
         flex-direction: column;
         align-items: flex-start;
       }
       .region-group .chip-title{
         margin: 0;               /* 標題不加底 margin，改由內容加上邊距 */
         line-height: 1.2;
         font-size: .8em;
       }
       .region-bar{
         flex-wrap: nowrap;
         gap: .6em;
         margin-top: .25em;       /* ← 與 .type-toggle-mobile 的 margin-top 對齊 */
       }
     }

    /* =========================
     * 手機抽屜（Type）— 從左側滑出，窄寬，保留下方內容可見
     * =======================*/
    .drawer-backdrop{
      display: none;
      position: fixed; inset: 0;
      background: rgba(0,0,0,.15);       /* 淡淡的，仍看得到底下內容 */
      z-index: 40;
    }
    .drawer-backdrop.is-open{ display: block; }

    .type-drawer{
      position:fixed;
      top: var(--nav-h);
      bottom: 0;
      left: 0;
      width: min(var(--drawer-w), var(--drawer-w-max));  /* 用變數控寬 */
      background: rgba(255,255,255,0.72);                /* 半透明白底 */
      backdrop-filter: blur(4px);                        /* 讓底下內容微糊 */
      z-index: 41;
      transform: translateX(-100%);                      /* 預設隱藏在左邊 */
      transition: transform .25s ease;
      box-shadow: 2px 0 10px rgba(0,0,0,0.1);
      padding: 1rem 1rem 1.25rem;
      display:flex;
      flex-direction:column;
      gap:1rem;
    }
    .type-drawer.is-open{ transform: translateX(0); }

    .drawer-header{
      display: flex; align-items: center; justify-content: space-between;
      padding-bottom: .25rem; border-bottom: 1px solid #eee;
    }
    .drawer-close{
      background: none; border: none; font-size: 1.5rem; line-height: 1; cursor: pointer;
    }

    /* drawer 選單：一列一個 */
    .drawer-list{
      display:flex;
      flex-direction:column;
      align-items:flex-start;
      gap:.2em;
    }
    .drawer-list .chip-title{ margin: 0 0 .5em 0; }

    /* chips：用 inline-block，底線只到文字 */
    .drawer-list .chip{
      display:inline-block;
      width:auto;
      text-align:left;
      padding:.35em 0;
      border-bottom:1px solid transparent;
      white-space:nowrap;
    }
    /* active：底線顯示（與桌機一致） */
    .drawer-list .chip.active{
      color:#000;
      border-bottom-color:#000;
    }
    .drawer-list .chip + .chip{ margin-top: .1em; }

    /* 抽屜只在手機有意義；桌機時確保不顯示 */
    @media (min-width: 901px){
      .type-drawer{ display: none; }
      .drawer-backdrop{ display: none !important; }
    }
  </style>
</head>

<body>
  <!-- ========= 第一層導覽 ========= -->
  <nav class="navbar">
    <div class="lang-toggle">
      <button class="lang-btn" data-lang-toggle="zh">中文</button> |
      <button class="lang-btn" data-lang-toggle="en">EN</button>
    </div>
    <div class="navbar-right">
      <a class="lang-en" href="/projects/">Projects</a>
      <a class="lang-en" href="/about/">About</a>
      <a class="lang-zh" href="/projects/">項目</a>
      <a class="lang-zh" href="/about/">關於</a>
    </div>
  </nav>

  <!-- ========= 第二層導覽 ========= -->
  <nav id="projectsSubnav" class="subnav">
    <div class="subnav-inner">
      <!-- ① TYPE（桌機：inline；手機：按鈕開抽屜） -->
      <div class="type-group" id="typeGroup">
        <!-- 桌機 inline chips（單行、溢出隱藏） -->
        <div class="type-inline">
          <span class="chip-title lang-en">Type:</span>
          <span class="chip-title lang-zh">類型：</span>
          <button class="chip type-chip" data-type="ALL"><span class="lang-en">All</span><span class="lang-zh">全部</span></button>
          <button class="chip type-chip" data-type="Residential"><span class="lang-en">Residential</span><span class="lang-zh">住宅</span></button>
          <button class="chip type-chip" data-type="Commercial"><span class="lang-en">Commercial</span><span class="lang-zh">商業</span></button>
          <button class="chip type-chip" data-type="Cultural"><span class="lang-en">Cultural</span><span class="lang-zh">文化</span></button>
          <button class="chip type-chip" data-type="Public"><span class="lang-en">Public</span><span class="lang-zh">公共</span></button>
          <button class="chip type-chip" data-type="Installation"><span class="lang-en">Installation</span><span class="lang-zh">裝置</span></button>
          <button class="chip type-chip" data-type="Workshop"><span class="lang-en">Workshop</span><span class="lang-zh">工作營</span></button>
          <button class="chip type-chip" data-type="Exhibition"><span class="lang-en">Exhibition</span><span class="lang-zh">展覽</span></button>
        </div>

        <!-- 手機：小標籤 + 按鈕 -->
        <div class="type-mobile">
          <span class="chip-title">
            <span class="lang-en">Type:</span>
            <span class="lang-zh">類型：</span>
          </span>
          <button id="typeToggleMobile" class="type-toggle-mobile" aria-expanded="false" aria-controls="typeDrawer">
             ▾
          </button>
        </div>
      </div> <!-- ←← 修正：關閉 type-group 容器 -->

      <!-- ② REGION（一直 inline；手機給較寬中欄） -->
      <div class="region-group">
        <span class="chip-title"><span class="lang-en">Region:</span><span class="lang-zh">地區：</span></span>
        <div class="chip-bar region-bar">
          <button class="chip region-chip active" data-region="all"><span class="lang-en">All</span><span class="lang-zh">全部</span></button>
          <button class="chip region-chip" data-region="taiwan"><span class="lang-en">Taiwan</span><span class="lang-zh">台灣</span></button>
          <button class="chip region-chip" data-region="china"><span class="lang-en">China</span><span class="lang-zh">中國</span></button>
          <button class="chip region-chip" data-region="overseas"><span class="lang-en">Others</span><span class="lang-zh">其他</span></button>
        </div>
      </div>

      <!-- ③ SORT -->
      <div class="sort-group">
        <span class="chip-title"><span class="lang-en">Sort by Year:</span><span class="lang-zh">按年排序：</span></span>
        <button id="sortToggle" class="sort-toggle" data-order="desc"><span id="sortArrow">↓</span></button>
      </div>
    </div>
  </nav>

  <!-- TYPE：手機左側窄抽屜（垂直清單，一行一個） -->
  <aside id="typeDrawer" class="type-drawer" aria-hidden="true">
    <div class="drawer-header">
      <button id="typeDrawerClose" class="drawer-close" aria-label="Close">×</button>
    </div>
    <div class="drawer-list">
      <div class="chip-title"><span class="lang-en">Choose types</span><span class="lang-zh">選擇類型</span></div>
      <button class="chip type-chip" data-type="ALL"><span class="lang-en">All</span><span class="lang-zh">全部</span></button>
      <button class="chip type-chip" data-type="Residential"><span class="lang-en">Residential</span><span class="lang-zh">住宅</span></button>
      <button class="chip type-chip" data-type="Commercial"><span class="lang-en">Commercial</span><span class="lang-zh">商業</span></button>
      <button class="chip type-chip" data-type="Cultural"><span class="lang-en">Cultural</span><span class="lang-zh">文化</span></button>
      <button class="chip type-chip" data-type="Public"><span class="lang-en">Public</span><span class="lang-zh">公共</span></button>
      <button class="chip type-chip" data-type="Installation"><span class="lang-en">Installation</span><span class="lang-zh">裝置</span></button>
      <button class="chip type-chip" data-type="Workshop"><span class="lang-en">Workshop</span><span class="lang-zh">工作營</span></button>
      <button class="chip type-chip" data-type="Exhibition"><span class="lang-en">Exhibition</span><span class="lang-zh">展覽</span></button>
    </div>
  </aside>
  <div id="typeBackdrop" class="drawer-backdrop" aria-hidden="true"></div>

  <!-- ========= 版身 ========= -->
  <div class="container">
    {% block content %}{{ content | safe }}{% endblock %}
  </div>

  <!-- ========= Scripts ========= -->
  <script>
    /* 語系切換 */
    function setLang(lang) {
      localStorage.setItem('lang', lang);
      document.documentElement.setAttribute('data-lang', lang);
      document.querySelectorAll('[data-lang-toggle]').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-lang-toggle') === lang);
      });
    }
    document.addEventListener("DOMContentLoaded", function () {
      const savedLang = localStorage.getItem('lang') || 'zh';
      setLang(savedLang);
      document.querySelectorAll('[data-lang-toggle]').forEach(btn => {
        btn.addEventListener('click', () => setLang(btn.getAttribute('data-lang-toggle') || 'zh'));
      });
    });

    /* 第二層 navbar 行為 */
    (function(){
      const subnav = document.getElementById('projectsSubnav');
      if (!subnav) return;

      const onProjectsPage = !!location.pathname.match(/^\/projects\/?$/);
      const $  = (s, r=document)=>r.querySelector(s);
      const $$ = (s, r=document)=>Array.from(r.querySelectorAll(s));

      // TYPE drawer (mobile)
      (function(){
        const btn      = document.getElementById('typeToggleMobile');
        const drawer   = document.getElementById('typeDrawer');
        const closeBtn = document.getElementById('typeDrawerClose');
        const backdrop = document.getElementById('typeBackdrop');

        if (!btn || !drawer || !closeBtn || !backdrop) return;

        function openDrawer(){
          drawer.classList.add('is-open');
          backdrop.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }
        function closeDrawer(){
          drawer.classList.remove('is-open');
          backdrop.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        btn.addEventListener('click', (e)=>{ e.preventDefault(); openDrawer(); });
        closeBtn.addEventListener('click', closeDrawer);
        backdrop.addEventListener('click', closeDrawer);
        document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeDrawer(); });
      })();

      // 單一 project 頁：點控制→導向 /projects/ 並帶參數
      if (!onProjectsPage) {
        $$('.type-chip', subnav).forEach(btn=>{
          btn.addEventListener('click', ()=>{
            const t = btn.dataset.type;
            if (t === 'ALL') return window.location.assign('/projects/');
            window.location.assign(`/projects/?types=${encodeURIComponent(t)}`);
          });
        });
        $$('.region-chip', subnav).forEach(btn=>{
          btn.addEventListener('click', ()=>{
            const r = btn.dataset.region;
            const url = (r && r !== 'all') ? `/projects/?region=${encodeURIComponent(r)}` : '/projects/';
            window.location.assign(url);
          });
        });
        const sortToggle = $('#sortToggle', subnav);
        if (sortToggle) {
          sortToggle.addEventListener('click', ()=>{
            const current = (sortToggle.dataset.order === 'asc') ? 'asc' : 'desc';
            const next = current === 'asc' ? 'desc' : 'asc';
            window.location.assign(`/projects/?order=${next}`);
          });
        }
        return;
      }

      // /projects/ 頁：即時篩選＋同步 URL
      const params     = new URLSearchParams(location.search);
      const initTypes  = (params.get('types')||'').split(',').filter(Boolean);
      const initRegion = params.get('region') || 'all';
      const initOrder  = params.get('order')  || 'desc';

      // === 類型（多選）— 同步桌機/抽屜的 active 狀態 ===
      const typeChips = Array.from(document.querySelectorAll('.type-chip')); // both desktop + drawer
      const selectedTypes = new Set(initTypes);

      function refreshAllChipActives(){
        const hasAny = selectedTypes.size > 0;
        typeChips.forEach(btn=>{
          const t = btn.dataset.type;
          if (t === 'ALL') {
            btn.classList.toggle('active', !hasAny);
          } else {
            btn.classList.toggle('active', selectedTypes.has(t));
          }
        });
      }
      refreshAllChipActives();

      typeChips.forEach(btn=>{
        btn.addEventListener('click', (e)=>{
          e.preventDefault();
          const t = btn.dataset.type;

          if (t === 'ALL') {
            selectedTypes.clear();
            refreshAllChipActives();
            applyFilters(); syncURL();
            return;
          }
          if (selectedTypes.has(t)) selectedTypes.delete(t);
          else selectedTypes.add(t);

          refreshAllChipActives();
          applyFilters(); syncURL();
        });
      });

      // === 地區（單選） ===
      const regionChips = Array.from(document.querySelectorAll('.region-chip'));
      let currentRegion = initRegion;
      regionChips.forEach(btn=>{
        if (btn.dataset.region === initRegion) btn.classList.add('active');
        btn.addEventListener('click', (e)=>{
          e.preventDefault();
          regionChips.forEach(b=>b.classList.remove('active'));
          btn.classList.add('active');
          currentRegion = btn.dataset.region;
          applyFilters(); syncURL();
        });
      });

      // === 排序（年分） ===
      const sortToggle = document.getElementById('sortToggle');
      const sortArrow  = document.getElementById('sortArrow');
      let currentOrder = (initOrder === 'asc') ? 'asc' : 'desc';
      if (sortArrow) sortArrow.textContent = currentOrder === 'asc' ? '↑' : '↓';
      if (sortToggle) {
        sortToggle.dataset.order = currentOrder;
        sortToggle.addEventListener('click', (e)=>{
          e.preventDefault();
          currentOrder = (currentOrder === 'asc') ? 'desc' : 'asc';
          sortToggle.dataset.order = currentOrder;
          if (sortArrow) sortArrow.textContent = currentOrder === 'asc' ? '↑' : '↓';
          applyFilters(); syncURL();
        });
      }

      // === 篩選核心 ===
      const list     = document.querySelector('.project-grid');
      const itemsAll = Array.from(document.querySelectorAll('.project-grid > .project'));

      function applyFilters(){
        const typeActive = [...selectedTypes];
        const showAllTypes = typeActive.length === 0;

        const filtered = itemsAll.filter(li=>{
          const t  = li.dataset.typeEn;
          const rg = li.dataset.region || 'overseas';
          const okType   = showAllTypes ? true : typeActive.includes(t);
          const okRegion = (currentRegion === 'all') ? true : (rg === currentRegion);
          return okType && okRegion;
        });

        filtered.sort((a,b)=>{
          const ay = parseInt(a.dataset.year || '0', 10);
          const by = parseInt(b.dataset.year || '0', 10);
          return currentOrder === 'asc' ? (ay - by) : (by - ay);
        });

        if (list) { list.innerHTML = ''; filtered.forEach(el => list.appendChild(el)); }
      }

      function syncURL(){
        const qp = new URLSearchParams();
        if (selectedTypes.size) qp.set('types', [...selectedTypes].join(','));
        if (currentRegion && currentRegion !== 'all') qp.set('region', currentRegion);
        if (currentOrder !== 'desc') qp.set('order', currentOrder);
        const qs = qp.toString();
        history.replaceState(null, '', qs ? ('?'+qs) : location.pathname);
      }

      applyFilters();
    })();
  </script>
</body>
</html>
