<!DOCTYPE html>
<html data-lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title_en or title_zh or 'Untitled Page' }}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/uploads/favicon.png">
  <link rel="shortcut icon" type="image/png" href="/uploads/favicon.png">
  <link rel="icon" type="image/png" href="/uploads/favicon.png?v=2">

  <style>
    /* =========================
     * 全域基礎（不碰 .project*）
     * =======================*/
    :root{
      --nav-h: 64px;      /* 第一層 navbar 高度 */
      --subnav-h: 64px;   /* 第二層 subnav 高度（桌機固定） */
      --container-w: 1000px;
    }

    html[data-lang='en'] .lang-zh { display: none !important; }
    html[data-lang='zh'] .lang-en { display: none !important; }

    body{
      font-family: sans-serif;
      margin: 0;
      padding: 0;
      color: #111;
      background: #fff;
    }

    .container{
      max-width: var(--container-w);
      margin: 2em auto;
      padding: 1em;
    }

    /* =========================
     * 第一層 Navbar（僅控制導覽列）
     * =======================*/
    .navbar{
      position: sticky; top: 0; z-index: 20;
      display: flex; align-items: center; justify-content: space-between;
      height: var(--nav-h);
      padding: 0 2em;
      background: #fff; border-bottom: 1px solid #ddd;
    }
    .navbar-right a{
      margin-left: 1em; color: #000; font-size: 1.1em; font-weight: bold;
      text-decoration: none; transition: color .2s ease;
    }
    .navbar-right a:hover{ color: #333; }

    .lang-toggle{ display: flex; align-items: center; gap: 6px; font-size: .9rem; }
    .lang-btn{
      padding: 2px 4px; background: none; border: none; color: gray; font-weight: normal;
      cursor: pointer; transition: color .2s ease;
    }
    .lang-btn.active{ color: #000; font-weight: bold; }
    .lang-btn:hover{ color: #333; }

    /* =========================
     * 第二層 Subnav（Type / Region / Sort）
     * =======================*/
    .subnav{
      position: sticky; top: var(--nav-h); z-index: 15;
      background: #fff; border-bottom: 1px solid #eee;
      height: var(--subnav-h);              /* 桌機固定高度 */
      min-height: var(--subnav-h);
      display: flex; align-items: center;   /* 內容垂直置中 */
    }

    .subnav-inner{
      max-width: var(--container-w);
      margin: 0 auto;
      padding: .6em 1em;
      width: 100%;

      /* 3 欄 Grid，欄位可縮、整體靠左 */
      display: grid;
      grid-template-columns:
        minmax(0, 1.4fr)   /* Type */
        minmax(0, 0.5fr)   /* Region */
        minmax(0, 0.3fr);  /* Sort */
      column-gap: 1.25em;
      align-items: center;     /* 讓每格內容在固定高內垂直置中 */
      justify-items: start;    /* 內容靠左 */
      justify-content: start;  /* 整個 grid 靠左 */
      grid-auto-rows: min-content;
    }
    .subnav-inner > *{ min-width: 0; } /* 允許欄位縮，避免把後兩欄擠走 */

    /* 標題（每欄上方） */
    .chip-title{
      display: block; font-size: .8em; color: #666; line-height: 1.2;
      margin-bottom: .2em;
    }

    /* 共用 chip 按鈕（僅限 subnav） */
    .chip-bar{ display: flex; flex-wrap: wrap; gap: .5em; align-items: center; }
    .chip{
      padding: 0; background: none; border: none; color: #555; cursor: pointer;
      font: inherit; text-decoration: none; border-bottom: 1px solid transparent;
      transition: color .2s, border-color .2s; font-size: .9em;
    }
    .chip:hover{ color: #000; }
    .chip.active{ color: #000; border-bottom-color: #000; }

    /* ========== TYPE（桌機：標題一行 + 選項一行；單行顯示避免撐高） ========== */
    .type-group{ position: relative; }
    .type-inline{
      display: flex;
      flex-wrap: nowrap;    /* 不換行 → subnav 不會被撐高 */
      overflow: hidden;     /* 多的隱藏 */
      gap: .5em;
      min-width: 0;
    }
    /* 讓「Type: / 類型：」獨佔一行，chips 在下一行 */
    .type-inline .chip-title{
      display: block;
      width: 100%;
      margin: 0 0 .2em 0;
      line-height: 1.2;
      color: #666;
      font-size: .8em;
      flex: 0 0 100%;
    }
    .type-inline .chip{
      flex: 0 0 auto;       /* chip 不被壓縮 */
      white-space: nowrap;  /* 單字不換行 */
    }

    /* ========== REGION（同樣單行） ========== */
    .region-group{ justify-self: start; }
    .region-bar{
      display: flex; flex-wrap: nowrap; gap: .5em; align-items: center;
      overflow: hidden;
    }
    .region-bar .chip{
      flex: 0 0 auto;
      white-space: nowrap;
    }

    /* ========== SORT ========== */
    .sort-group{
      display: flex; flex-direction: column; align-items: flex-start; justify-self: start;
    }
    .sort-toggle{
      margin-top: .1em; background: none; border: none; cursor: pointer; font: inherit; color: #333;
      border-bottom: 1px solid transparent; padding: 0; line-height: 1; font-size: .9em;
    }
    .sort-toggle:hover{ border-bottom-color:#333; }
    #sortArrow{ display: inline-block; }

    /* ========== 手機（< 900px）：改用折疊面板，subnav 高度自適應 ========== */
    .type-toggle{
      display: none;
      align-items: center; gap:.5em;
      background: none; border: none; cursor: pointer; padding: 0;
      color:#333; font: inherit; border-bottom:1px solid transparent;
    }
    .type-toggle:hover{ border-bottom-color:#333; }
    .type-toggle .caret{ font-size: 1.1em; line-height: 1; }

    .type-panel-backdrop{
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,.2); z-index: 20;
    }
    .type-panel{
      display: none; position: absolute; left: 0; top: calc(100% + .5em);
      width: min(90vw, 720px);
      background: #fff; border: 1px solid #ddd; border-radius: 10px;
      box-shadow: 0 8px 30px rgba(0,0,0,.12);
      padding: .9em; z-index: 21;
    }
    .type-panel .chip-title{ margin-bottom: .5em; }
    .type-panel .chip-bar{ max-height: 45vh; overflow: auto; }

    .type-group.is-open .type-panel,
    .type-group.is-open ~ .type-panel-backdrop{ display: block; }

    @media (max-width: 900px){
      .subnav{ height: auto; min-height: var(--subnav-h); }  /* 改為自適應高度 */
      .subnav-inner{
        align-items: start;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        row-gap: .6em;
      }
      .type-inline{ display: none; }     /* 改用切換鈕 + 浮層 */
      .type-toggle{ display: inline-flex; }
    }
  </style>

</head>
<body>
  <!-- ========= 第一層導覽 ========= -->
  <nav class="navbar">
    <div class="lang-toggle">
      <button class="lang-btn" data-lang-toggle="zh">中文</button> |
      <button class="lang-btn" data-lang-toggle="en">EN</button>
    </div>
    <div class="navbar-right">
      <a class="lang-en" href="/projects/">Projects</a>
      <a class="lang-en" href="/about/">About</a>
      <a class="lang-zh" href="/projects/">項目</a>
      <a class="lang-zh" href="/about/">關於</a>
    </div>
  </nav>

  <nav id="projectsSubnav" class="subnav">
    <div class="subnav-inner">
      <!-- 第一欄：Type -->
      <div class="type-group" id="typeGroup">
        <!-- 桌機：標題 + chips（排列方式與 Region 一致） -->
        <span class="chip-title">
          <span class="lang-en">Type:</span>
          <span class="lang-zh">類型：</span>
        </span>
        <div class="chip-bar type-inline">
          <button class="chip type-chip" data-type="ALL">
            <span class="lang-en">All</span><span class="lang-zh">全部</span>
          </button>
          <button class="chip type-chip" data-type="Residential">
            <span class="lang-en">Residential</span><span class="lang-zh">住宅</span>
          </button>
          <button class="chip type-chip" data-type="Commercial">
            <span class="lang-en">Commercial</span><span class="lang-zh">商業</span>
          </button>
          <button class="chip type-chip" data-type="Cultural">
            <span class="lang-en">Cultural</span><span class="lang-zh">文化</span>
          </button>
          <button class="chip type-chip" data-type="Public">
            <span class="lang-en">Public</span><span class="lang-zh">公共</span>
          </button>
          <button class="chip type-chip" data-type="Installation">
            <span class="lang-en">Installation</span><span class="lang-zh">裝置</span>
          </button>
          <button class="chip type-chip" data-type="Workshop">
            <span class="lang-en">Workshop</span><span class="lang-zh">工作營</span>
          </button>
          <button class="chip type-chip" data-type="Exhibition">
            <span class="lang-en">Exhibition</span><span class="lang-zh">展覽</span>
          </button>
        </div>

        <!-- 手機：切換鈕 + 浮層（維持原互動） -->
        <button class="type-toggle" id="typeToggle" aria-expanded="false" aria-controls="typePanel">
          <span class="caret">▾</span>
        </button>
        <div class="type-panel" id="typePanel" role="dialog" aria-modal="true" aria-label="Filter by type">
          <div class="chip-title">
            <span class="lang-en">Type:</span>
            <span class="lang-zh">類型：</span>
          </div>
          <div class="chip-bar">
            <button class="chip type-chip" data-type="ALL">
              <span class="lang-en">All</span><span class="lang-zh">全部</span>
            </button>
            <button class="chip type-chip" data-type="Residential">
              <span class="lang-en">Residential</span><span class="lang-zh">住宅</span>
            </button>
            <button class="chip type-chip" data-type="Commercial">
              <span class="lang-en">Commercial</span><span class="lang-zh">商業</span>
            </button>
            <button class="chip type-chip" data-type="Cultural">
              <span class="lang-en">Cultural</span><span class="lang-zh">文化</span>
            </button>
            <button class="chip type-chip" data-type="Public">
              <span class="lang-en">Public</span><span class="lang-zh">公共</span>
            </button>
            <button class="chip type-chip" data-type="Installation">
              <span class="lang-en">Installation</span><span class="lang-zh">裝置</span>
            </button>
            <button class="chip type-chip" data-type="Workshop">
              <span class="lang-en">Workshop</span><span class="lang-zh">工作營</span>
            </button>
            <button class="chip type-chip" data-type="Exhibition">
              <span class="lang-en">Exhibition</span><span class="lang-zh">展覽</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 第二欄：Region -->
      <div class="region-group">
        <span class="chip-title">
          <span class="lang-en">Region:</span>
          <span class="lang-zh">地區：</span>
        </span>
        <div class="chip-bar region-bar">
          <button class="chip region-chip active" data-region="all">
            <span class="lang-en">All</span><span class="lang-zh">全部</span>
          </button>
          <button class="chip region-chip" data-region="taiwan">
            <span class="lang-en">Taiwan</span><span class="lang-zh">台灣</span>
          </button>
          <button class="chip region-chip" data-region="china">
            <span class="lang-en">China</span><span class="lang-zh">中國</span>
          </button>
          <button class="chip region-chip" data-region="overseas">
            <span class="lang-en">Others</span><span class="lang-zh">其他</span>
          </button>
        </div>
      </div>

      <!-- 第三欄：Sort -->
      <div class="sort-group">
        <span class="chip-title sort-label">
          <span class="lang-en">Sort by Year:</span>
          <span class="lang-zh">按年排序：</span>
        </span>
        <button id="sortToggle" class="sort-toggle" data-order="desc">
          <span id="sortArrow">↓</span>
        </button>
      </div>

      <!-- Backdrop 要留在 .subnav-inner 裡，同層級於三欄 -->
      <div class="type-panel-backdrop" id="typeBackdrop"></div>
    </div><!-- ← 補齊這個 .subnav-inner 的收尾 -->
  </nav>

  <!-- ========= 版身 ========= -->
  <div class="container">
    {% block content %}{{ content | safe }}{% endblock %}
  </div>

  <!-- ========= Scripts ========= -->
  <script>
    /* 語系切換 */
    function setLang(lang) {
      localStorage.setItem('lang', lang);
      document.documentElement.setAttribute('data-lang', lang);
      document.querySelectorAll('[data-lang-toggle]').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-lang-toggle') === lang);
      });
    }
    document.addEventListener("DOMContentLoaded", function () {
      const savedLang = localStorage.getItem('lang') || 'zh';
      setLang(savedLang);
      document.querySelectorAll('[data-lang-toggle]').forEach(btn => {
        btn.addEventListener('click', () => setLang(btn.getAttribute('data-lang-toggle') || 'zh'));
      });
    });

    /* 第二層 navbar 行為 */
    (function(){
      const subnav = document.getElementById('projectsSubnav');
      if (!subnav) return;

      const onProjectsPage = !!location.pathname.match(/^\/projects\/?$/);
      const $  = (s, r=document)=>r.querySelector(s);
      const $$ = (s, r=document)=>Array.from(r.querySelectorAll(s));

      (function(){
        const group    = document.getElementById('typeGroup');
        const toggle   = document.getElementById('typeToggle');
        const panel    = document.getElementById('typePanel');
        const backdrop = document.getElementById('typeBackdrop');

        if (!group || !toggle || !panel || !backdrop) return;

        function openPanel(){
          group.classList.add('is-open');
          toggle.setAttribute('aria-expanded', 'true');
        }
        function closePanel(){
          group.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        }
        function isMobile(){ return window.matchMedia('(max-width: 900px)').matches; }

        // Toggle open/close only on mobile
        toggle.addEventListener('click', (e)=>{
          if (!isMobile()) return;
          e.preventDefault();
          group.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', group.classList.contains('is-open') ? 'true' : 'false');
        });

        // Close when clicking backdrop or pressing Escape
        backdrop.addEventListener('click', closePanel);
        document.addEventListener('keydown', (e)=>{ if (e.key === 'Escape') closePanel(); });

        // Auto-close when resizing back to desktop
        window.addEventListener('resize', ()=>{ if (!isMobile()) closePanel(); });
      })();

      // 單一 project 頁：點控制→導向 /projects/ 並帶參數
      if (!onProjectsPage) {
        $$('.type-chip', subnav).forEach(btn=>{
          btn.addEventListener('click', ()=>{
            const t = btn.dataset.type;
            if (t === 'ALL') return window.location.assign('/projects/');
            window.location.assign(`/projects/?types=${encodeURIComponent(t)}`);
          });
        });
        $$('.region-chip', subnav).forEach(btn=>{
          btn.addEventListener('click', ()=>{
            const r = btn.dataset.region;
            const url = (r && r !== 'all') ? `/projects/?region=${encodeURIComponent(r)}` : '/projects/';
            window.location.assign(url);
          });
        });
        const sortToggle = $('#sortToggle', subnav);
        if (sortToggle) {
          sortToggle.addEventListener('click', ()=>{
            const current = (sortToggle.dataset.order === 'asc') ? 'asc' : 'desc';
            const next = current === 'asc' ? 'desc' : 'asc';
            window.location.assign(`/projects/?order=${next}`);
          });
        }
        return;
      }

      // /projects/ 頁：即時篩選＋同步 URL
      const params     = new URLSearchParams(location.search);
      const initTypes  = (params.get('types')||'').split(',').filter(Boolean);
      const initRegion = params.get('region') || 'all';
      const initOrder  = params.get('order')  || 'desc';

      // 類型（多選）
      const typeChips = $$('.type-chip', subnav);
      const selectedTypes = new Set(initTypes);
      typeChips.forEach(btn=>{
        const t = btn.dataset.type;
        if (t !== 'ALL' && selectedTypes.has(t)) btn.classList.add('active');

        btn.addEventListener('click', ()=>{
          if (t === 'ALL') {
            // 清空所有選擇
            selectedTypes.clear();
            typeChips.forEach(b=>b.classList.remove('active'));
            applyFilters(); syncURL(); return;
          }
          btn.classList.toggle('active');
          if (btn.classList.contains('active')) selectedTypes.add(t); else selectedTypes.delete(t);
          applyFilters(); syncURL();
        });
      });

      // 地區（單選）
      const regionChips = $$('.region-chip', subnav);
      let currentRegion = initRegion;
      regionChips.forEach(btn=>{
        if (btn.dataset.region === initRegion) btn.classList.add('active');
        btn.addEventListener('click', ()=>{
          regionChips.forEach(b=>b.classList.remove('active'));
          btn.classList.add('active');
          currentRegion = btn.dataset.region;
          applyFilters(); syncURL();
        });
      });

      // 排序（年分）
      const sortToggle = $('#sortToggle', subnav);
      const sortArrow  = $('#sortArrow', subnav);
      let currentOrder = (initOrder === 'asc') ? 'asc' : 'desc';
      if (sortArrow) sortArrow.textContent = currentOrder === 'asc' ? '↑' : '↓';
      if (sortToggle) {
        sortToggle.dataset.order = currentOrder;
        sortToggle.addEventListener('click', ()=>{
          currentOrder = (currentOrder === 'asc') ? 'desc' : 'asc';
          sortToggle.dataset.order = currentOrder;
          if (sortArrow) sortArrow.textContent = currentOrder === 'asc' ? '↑' : '↓';
          applyFilters(); syncURL();
        });
      }

      // 篩選核心
      const list     = $('.project-grid');
      const itemsAll = $$('.project-grid > .project');

      function applyFilters(){
        const typeActive = [...selectedTypes];
        const showAllTypes = typeActive.length === 0;

        const filtered = itemsAll.filter(li=>{
          const t  = li.dataset.typeEn;                   // 英文類型
          const rg = li.dataset.region || 'overseas';     // 區域（由 projects.njk 推論）
          const okType   = showAllTypes ? true : typeActive.includes(t);
          const okRegion = (currentRegion === 'all') ? true : (rg === currentRegion);
          return okType && okRegion;
        });

        filtered.sort((a,b)=>{
          const ay = parseInt(a.dataset.year || '0', 10);
          const by = parseInt(b.dataset.year || '0', 10);
          return currentOrder === 'asc' ? (ay - by) : (by - ay);
        });

        if (list) { list.innerHTML = ''; filtered.forEach(el => list.appendChild(el)); }
      }

      function syncURL(){
        const qp = new URLSearchParams();
        if (selectedTypes.size) qp.set('types', [...selectedTypes].join(','));
        if (currentRegion && currentRegion !== 'all') qp.set('region', currentRegion);
        if (currentOrder !== 'desc') qp.set('order', currentOrder);
        const qs = qp.toString();
        history.replaceState(null, '', qs ? ('?'+qs) : location.pathname);
      }

      applyFilters();
    })();
  </script>
</body>
</html>
