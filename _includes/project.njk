{% extends "layout.njk" %}

{% block content %}
<style>
  .project-hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-heith: 500px;
    overflow: hidden;
    position: relative;
    margin-bottom: 2.5em;
}

  .project-hero img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
}

  .project-title {
    text-align: center;
    font-size: 18pt;
    font-weight: bold;
    margin-top: 1em;
    margin-bottom: 1em;
}

  .project-section-title {
    text-align: center;
    font-size: 1.2em;
    font-weight: bold;
    margin: 2em 0 1em;
    color: #444;
}

  .project-meta {
    text-align: center;
    font-size: 0.9em;
    color: gray;
    margin-bottom: 4em;
}

  .project-content {
    max-width: 800px;
    margin: 0 auto 2em;
    line-height: 1.6;
}

  .project-slider {
    max-width: 100%;
    margin: 2em auto;
    position: relative;
}

  .slider-window {
    position: relative;
}

  .slide {
    display: none;
    width: 100%;
}

  .slide.active {
    display: block;
}

  .slide-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;     /* ✅ 保持圖片區為 16:9 */
    overflow: hidden;
}

  .slide-image-wrapper img {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

  .gallery-caption {
    margin-top: 0.5em;
    padding: 0.5em 1em;
    text-align: center;
    font-size: 0.85em;
    color: gray;
}

  /* 左右箭頭位置 — 垂直置中在圖片區 */
  .slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.7);
    border: none;
    font-size: 1.5em;
    cursor: pointer;
    z-index: 2;
}

  .slider-btn.prev {
    left: 1em;
}

  .slider-btn.next {
    right: 1em;
}

  .lightbox {
    display: none;
    position: fixed;
    z-index: 999;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.9);
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

  .lightbox img {
    max-width: 90vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
}

  .lightbox-caption {
    color: white;
    margin-top: 1em;
    font-size: 0.9em;
}

  .lightbox-controls {
    position: absolute;
    width: 100%;
    top: 50%;
    display: flex;
    justify-content: space-between;
    padding: 0 2em;
}

  .lightbox-btn {
    color: white;
    font-size: 2em;
    background: transparent;
    border: none;
    cursor: pointer;
}

  .lightbox-close {
    position: absolute;
    top: 1em;
    right: 2em;
    color: white;
    font-size: 2em;
    cursor: pointer;
}

  .section-divider {
    border: none;
    border-top: 1px solid #ccc;
    margin: 5em auto;
    width: 60%;
}
  .video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    object-fit: cover;
    max-height: 500px;
}

  .video-container iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    border: 0;
}

@media (max-width: 600px) {
  .project-hero,
  .video-container {
    max-height: 300px;
  }
}
</style>

{% if thumbnail %}
  <div class="project-hero">
    <img src="{{ thumbnail }}" alt="Project thumbnail">
  </div>
{% endif %}

<h1 class="project-title">
  <span class="lang-en">{{ title_en }}</span>
  <span class="lang-zh">{{ title_zh }}</span>
</h1>

<p class="project-meta">
  {{ year }}｜
  <span class="lang-en">{{ location_en }} | {{ type }}</span>
  <span class="lang-zh">{{ location_zh }} | {{ type_zh }}</span>
</p>

<div class="project-content">
  <div class="lang-en">
    {{ body_en | markdown | safe }}
  </div>
  <div class="lang-zh">
    {{ body_zh | markdown | safe }}
  </div>
</div>

<hr class="section-divider">
{% if gallery %}
<h2 class="project-section-title">
  <span class="lang-en">Project Gallery</span>
  <span class="lang-zh" style="display: none;">項目照片</span>
</h2>

<div class="project-slider">
  <div class="slider-window" id="sliderWindow">
    {% for item in gallery %}
    <div class="slide{% if loop.first %} active{% endif %}">
      <div class="slide-image-wrapper">
        <img src="{{ item.image }}" data-index="{{ loop.index0 }}" onclick="openLightbox({{ loop.index0 }})" loading="lazy">
      </div>
      <div class="gallery-caption">
        <span class="lang-en">{{ item.caption_en }}</span>
        <span class="lang-zh">{{ item.caption_zh }}</span>
      </div>
    </div>
    {% endfor %}

    <button class="slider-btn prev" onclick="moveSlide(-1)">←</button>
    <button class="slider-btn next" onclick="moveSlide(1)">→</button>
  </div>
</div>

<div class="lightbox" id="lightbox">
  <div class="lightbox-controls">
    <button class="lightbox-btn" onclick="changeLightbox(-1)">←</button>
    <button class="lightbox-btn" onclick="changeLightbox(1)">→</button>
  </div>
  <img id="lightboxImage" src="">
  <div class="lightbox-caption" id="lightboxCaption"></div>
  <div class="lightbox-close" onclick="closeLightbox()">×</div>
</div>
{% endif %}
<hr class="section-divider">
{% if video %}
<h2 class="project-section-title" style="text-align: center;">
  <span class="lang lang-en">Project Video</span>
  <span class="lang lang-zh" style="display: none;">項目影片</span>
</h2>
  <div class="project-video" style="text-align: center; margin-top: 2em;">
  <div class="video-container">
<iframe
  src="{{ video }}"
  title="YouTube video"
  frameborder="0"
  allowfullscreen>
</iframe>
</div>
  </div>
{% endif %}

<script>
  const slides = document.querySelectorAll(".slide");
  let currentIndex = 0;

  function showSlide(index) {
    slides.forEach((s, i) => s.classList.toggle("active", i === index));
    currentIndex = index;
  }

  function moveSlide(dir) {
    let next = (currentIndex + dir + slides.length) % slides.length;
    showSlide(next);
  }

  // Lightbox
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightboxImage");
  const lightboxCaption = document.getElementById("lightboxCaption");

  const images = Array.from(document.querySelectorAll(".slide img"));
  const captions = Array.from(document.querySelectorAll(".gallery-caption"));

  function openLightbox(index) {
    lightbox.style.display = "flex";
    updateLightbox(index);
  }

  function updateLightbox(index) {
    const img = images[index];
    const caption = captions[index];
    if (!img) return;
    lightboxImg.src = img.src;

    const currentLang = document.documentElement.getAttribute("data-lang");
    const activeCaption = caption?.querySelector(`.lang-${currentLang}`);
    lightboxCaption.textContent = activeCaption?.textContent?.trim() || "";
    currentIndex = index;
  }

  function changeLightbox(dir) {
    const next = (currentIndex + dir + images.length) % images.length;
    updateLightbox(next);
  }

  function closeLightbox() {
    lightbox.style.display = "none";
  }

  // 點擊圖片開啟 lightbox
  images.forEach((img, i) => {
    img.addEventListener("click", () => openLightbox(i));
  });

  // Touch swipe
  let startX = 0;
  document.getElementById("sliderWindow").addEventListener("touchstart", e => {
    startX = e.touches[0].clientX;
  });
  document.getElementById("sliderWindow").addEventListener("touchend", e => {
    let deltaX = e.changedTouches[0].clientX - startX;
    if (deltaX > 50) moveSlide(-1);
    else if (deltaX < -50) moveSlide(1);
  });

  // 鍵盤支援：Esc 離開、左右切換
  document.addEventListener("keydown", function (e) {
    if (lightbox.style.display === "flex") {
      if (e.key === "Escape") {
        closeLightbox();
      } else if (e.key === "ArrowRight") {
        changeLightbox(1);
      } else if (e.key === "ArrowLeft") {
        changeLightbox(-1);
      }
    }
  });

  // 初始化顯示第一張
  showSlide(currentIndex);
</script>
{% endblock %}
