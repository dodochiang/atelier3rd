{% extends "layout.njk" %}

{% block content %}

{# ========= 類型對照 ========= #}
{% set TYPE_ZH = {
  "Residential": "住宅",
  "Commercial": "商業",
  "Cultural": "文化",
  "Public": "公共",
  "Installation": "裝置",
  "Workshop": "工作營",
  "Exhibition": "展覽"
} %}
{% set TYPE_EN = {
  "住宅": "Residential",
  "商業": "Commercial",
  "文化": "Cultural",
  "公共": "Public",
  "裝置": "Installation",
  "工作營": "Workshop",
  "展覽": "Exhibition"
} %}

{# ========= 扁平欄位 ========= #}
{% set loc_en = location_en or location %}
{% set loc_zh = location_zh or location %}
{% set type_en = type %}
{% set type_zh_display = TYPE_ZH[type_en] or type_en %}

{# ========= 取出並規則化 thumbnail（不使用巨集） ========= #}
{% set thumb = '' %}
{% if thumbnail is string %}
  {% set thumb = thumbnail %}
{% elseif thumbnail %}
  {% if thumbnail.secure_url is defined and thumbnail.secure_url %}
    {% set thumb = thumbnail.secure_url %}
  {% elif thumbnail.url is defined and thumbnail.url %}
    {% set thumb = thumbnail.url %}
  {% elif thumbnail.path is defined and thumbnail.path %}
    {% set thumb = thumbnail.path %}
  {% elif thumbnail.public_id is defined and thumbnail.public_id %}
    {# 只有 public_id → 這裡才組一次完整 Cloudinary URL #}
    {% set ext = (thumbnail.extension is defined and thumbnail.extension) and ('.' ~ thumbnail.extension) or '' %}
    {% set thumb = 'https://res.cloudinary.com/dw6nekwxn/image/upload/' ~ thumbnail.public_id ~ ext %}
  {% endif %}
{% endif %}

{% set heroSrc = (thumb or '') | trim %}
{% if heroSrc %}
  {% set low = heroSrc | lower %}
  {% set is_http  = (low | slice(0,7)) == 'http://' %}
  {% set is_https = (low | slice(0,8)) == 'https://' %}
  {% set is_proto = (heroSrc | slice(0,2)) == '//' %}
  {% set is_data  = (low | slice(0,5)) == 'data:' %}

  {% if is_http or is_https or is_proto or is_data %}
    {% set heroSrc = heroSrc %}
  {% elif (heroSrc | slice(0,1)) == '/' %}
    {% set heroSrc = heroSrc %}
  {% elif (low | slice(0,8)) == 'uploads/' or (low | slice(0,15)) == 'static/uploads/' %}
    {% set heroSrc = '/' ~ heroSrc %}
  {% else %}
    {# 其它情況（已是完整 Cloudinary 參數化網址、公網網址、或不需前綴的字串）→ 原樣 #}
    {% set heroSrc = heroSrc %}
  {% endif %}

  {# 防呆：剝掉意外雙前綴/雙斜線 #}
  {% set cloudPrefix = 'https://res.cloudinary.com/dw6nekwxn/image/upload/' %}
  {% set heroSrc = heroSrc
    | replace(cloudPrefix ~ 'https://', 'https://')
    | replace(cloudPrefix ~ 'http://', 'http://')
    | replace('image/upload//', 'image/upload/') %}
{% endif %}

<style>
  .project-hero { width:100%; aspect-ratio:16/9; max-height:500px; overflow:hidden; position:relative; margin-bottom:2.5em; }
  .project-hero img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; display:block; }
  .project-title { text-align:center; font-size:18pt; font-weight:bold; margin:1em 0; }
  .project-section-title { text-align:center; font-size:1.2em; font-weight:bold; margin:2em 0 1em; color:#444; }
  .project-meta-line { text-align:center; font-size:.9em; color:gray; }
  .project-meta-line + .project-meta-line { margin-top:.25em; }
  .project-content { max-width:800px; margin:0 auto 2em; line-height:1.6; }
  .project-credits { max-width:800px; margin:0 auto 1.5em; font-size:.85em; color:#777; line-height:1.5; }
  .project-credits h3 { margin:0 0 .4em; font-size:1em; font-weight:700; color:#666; text-align:left; }
  .project-credits p { margin:.2em 0; }
  .project-credits ul { margin:.3em 0 .6em 1.2em; }
  .project-slider { max-width:100%; margin:2em auto; position:relative; }
  .slider-window { position:relative; }
  .slide { display:none; width:100%; }
  .slide.active { display:block; }
  .slide-image-wrapper { position:relative; width:100%; aspect-ratio:16/9; overflow:hidden; }
  .slide-image-wrapper img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; cursor:zoom-in; }
  .gallery-caption { margin-top:.5em; padding:.5em 1em; text-align:center; font-size:.85em; color:gray; }
  .slider-btn { position:absolute; top:50%; transform:translateY(-50%); background:rgba(255,255,255,.7); border:none; cursor:pointer; z-index:2; line-height:1; padding:.2em .5em; border-radius:.4em; font-size:1.5em; }
  .slider-btn.prev { left:1em; }
  .slider-btn.next { right:1em; }
  .lightbox { display:none; position:fixed; z-index:999; inset:0; background:rgba(0,0,0,.9); align-items:center; justify-content:center; flex-direction:column; }
  .lightbox img { max-width:90vw; max-height:80vh; width:auto; height:auto; object-fit:contain; }
  .lightbox-caption { color:#fff; margin-top:1em; font-size:.9em; text-align:center; padding:0 .75em; }
  .lightbox-controls { position:absolute; width:100%; top:50%; display:flex; justify-content:space-between; padding:0 2em; }
  .lightbox-btn { color:#fff; font-size:2em; background:transparent; border:none; cursor:pointer; }
  .lightbox-close { position:absolute; top:1em; right:2em; color:#fff; font-size:2em; cursor:pointer; }
  .section-divider { border:none; border-top:1px solid #ccc; margin:5em auto; width:60%; }
  .video-container { position:relative; width:100%; aspect-ratio:4/3; overflow:hidden; max-height:500px; }
  .video-container iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }
  @media (max-width:600px){ .project-hero, .video-container { max-height:300px; } }
</style>

{% if heroSrc %}
  <div class="project-hero">
    <img src="{{ heroSrc | safe }}" alt="Project thumbnail" loading="lazy" decoding="async" referrerpolicy="no-referrer-when-downgrade">
  </div>
{% endif %}

<h1 class="project-title">
  <span class="lang-en">{{ title_en }}</span>
  <span class="lang-zh">{{ title_zh }}</span>
</h1>

{# ===== 面積/戶數格式化 ===== #}
{% set _fa = floor_area %}
{% set _un = units %}
{% if _fa is not none %}
  {% set fa_str = (_fa ~ '') %}
  {% if ('㎡' in fa_str) or ('m²' in fa_str) or ('sqm' in (fa_str|lower)) %}
    {% set fa_en = fa_str %}{% set fa_zh = fa_str %}
  {% else %}
    {% set fa_en = fa_str ~ ' sqm' %}
    {% set fa_zh = fa_str ~ '㎡' %}
  {% endif %}
{% endif %}
{% if _un is not none %}
  {% set un_str = (_un ~ '') %}
  {% if ('戶' in un_str) or ('units' in (un_str|lower)) %}
    {% set units_en = un_str %}{% set units_zh = un_str %}
  {% else %}
    {% set units_en = un_str ~ ' units' %}
    {% set units_zh = un_str ~ '戶' %}
  {% endif %}
{% endif %}

{# ===== 第一行：類型｜地點 ===== #}
<p class="project-meta-line">
  <span class="lang-en">
    {% if type_en %}{{ type_en }}{% endif %}
    {% if loc_en %}｜{{ loc_en }}{% endif %}
  </span>
  <span class="lang-zh">
    {% if type_zh_display %}{{ type_zh_display }}{% endif %}
    {% if loc_zh %}｜{{ loc_zh }}{% endif %}
  </span>
</p>

{# ===== 第二行：戶數｜面積｜年份 ===== #}
<p class="project-meta-line">
  <span class="lang-en">
    {% if units_en %}{{ units_en }}{% endif %}
    {% if fa_en %}｜{{ fa_en }}{% endif %}
    {% if year %}｜{{ year }}{% endif %}
  </span>
  <span class="lang-zh">
    {% if units_zh %}{{ units_zh }}{% endif %}
    {% if fa_zh %}｜{{ fa_zh }}{% endif %}
    {% if year %}｜{{ year }}{% endif %}
  </span>
</p>

<div class="project-content">
  <div class="lang-en">{{ body_en | markdown | safe }}</div>
  <div class="lang-zh">{{ body_zh | markdown | safe }}</div>
</div>

{% if credits_en or credits_zh %}
  <div class="project-credits">
    <div class="lang-en">{{ credits_en | markdown | safe }}</div>
    <div class="lang-zh">{{ credits_zh | markdown | safe }}</div>
  </div>
{% endif %}

<hr class="section-divider">

{# ===== 相簿來源整合：優先進階（含 caption），否則簡易（多選） ===== #}
{% set gallery_list = [] %}
{% if gallery and (gallery | length) %}
  {% set gallery_list = gallery %}
{% elif gallery_images and (gallery_images | length) %}
  {% set gallery_list = gallery_images %}
{% endif %}

{% if gallery_list and (gallery_list | length) %}
  <h2 class="project-section-title">
    <span class="lang-en">Project Gallery</span>
    <span class="lang-zh">項目照片</span>
  </h2>

  <div class="project-slider">
    <div class="slider-window" id="sliderWindow">
      {% for g in gallery_list %}
        {# —— 取出每張圖的原始值（字串或物件），盡量跟 projects.njk 的規則一致 —— #}
        {% set raw = (g.image is defined) and g.image or g %}
        {% set img = '' %}
        {% if raw is string %}
          {% set img = raw %}
        {% elseif raw %}
          {% if raw.secure_url is defined and raw.secure_url %}
            {% set img = raw.secure_url %}
          {% elif raw.url is defined and raw.url %}
            {% set img = raw.url %}
          {% elif raw.path is defined and raw.path %}
            {% set img = raw.path %}
          {% elif raw.public_id is defined and raw.public_id %}
            {% set ext = (raw.extension is defined and raw.extension) and ('.' ~ raw.extension) or '' %}
            {% set img = 'https://res.cloudinary.com/dw6nekwxn/image/upload/' ~ raw.public_id ~ ext %}
          {% endif %}
        {% endif %}

        {% set imgSrc = (img or '') | trim %}
        {% if imgSrc %}
          {% set lowI = imgSrc | lower %}
          {% set i_http  = (lowI | slice(0,7)) == 'http://' %}
          {% set i_https = (lowI | slice(0,8)) == 'https://' %}
          {% set i_proto = (imgSrc | slice(0,2)) == '//' %}
          {% set i_data  = (lowI | slice(0,5)) == 'data:' %}
          {% if i_http or i_https or i_proto or i_data %}
            {% set imgSrc = imgSrc %}
          {% elif (imgSrc | slice(0,1)) == '/' %}
            {% set imgSrc = imgSrc %}
          {% elif (lowI | slice(0,8)) == 'uploads/' or (lowI | slice(0,15)) == 'static/uploads/' %}
            {% set imgSrc = '/' ~ imgSrc %}
          {% else %}
            {% set imgSrc = imgSrc %}
          {% endif %}
          {% set imgSrc = imgSrc
            | replace('https://res.cloudinary.com/dw6nekwxn/image/upload/https://', 'https://')
            | replace('https://res.cloudinary.com/dw6nekwxn/image/upload/http://', 'http://')
            | replace('image/upload//', 'image/upload/') %}
        {% endif %}

        {% set cap_en = (g.caption_en is defined) and (g.caption_en or '') or '' %}
        {% set cap_zh = (g.caption_zh is defined) and (g.caption_zh or '') or '' %}

        <div class="slide{% if loop.first %} active{% endif %}">
          <div class="slide-image-wrapper">
            {% if imgSrc %}
              <img src="{{ imgSrc | safe }}" data-index="{{ loop.index0 }}" onclick="openLightbox({{ loop.index0 }})" loading="lazy" decoding="async" referrerpolicy="no-referrer-when-downgrade">
            {% endif %}
          </div>
          <div class="gallery-caption">
            <span class="lang-en">{{ cap_en }}</span>
            <span class="lang-zh">{{ cap_zh }}</span>
          </div>
        </div>
      {% endfor %}

      <button class="slider-btn prev" onclick="moveSlide(-1)" aria-label="Previous">←</button>
      <button class="slider-btn next" onclick="moveSlide(1)" aria-label="Next">→</button>
    </div>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
    <div class="lightbox-controls">
      <button class="lightbox-btn" onclick="changeLightbox(-1)" aria-label="Previous">←</button>
      <button class="lightbox-btn" onclick="changeLightbox(1)" aria-label="Next">→</button>
    </div>
    <img id="lightboxImage" src="" alt="">
    <div class="lightbox-caption" id="lightboxCaption"></div>
    <div class="lightbox-close" onclick="closeLightbox()" aria-label="Close">×</div>
  </div>
{% endif %}

<hr class="section-divider">

{% if video %}
  <h2 class="project-section-title">
    <span class="lang-en">Project Video</span>
    <span class="lang-zh">項目影片</span>
  </h2>
  <div class="project-video" style="text-align: center; margin-top: 2em;">
    <div class="video-container">
      <iframe src="{{ video }}" title="YouTube video" frameborder="0" allowfullscreen></iframe>
    </div>
  </div>
{% endif %}

<script>
  const slides = document.querySelectorAll(".slide");
  let currentIndex = 0;
  function showSlide(index){ slides.forEach((s,i)=>s.classList.toggle("active", i===index)); currentIndex=index; }
  function moveSlide(dir){ if(!slides.length) return; const next=(currentIndex+dir+slides.length)%slides.length; showSlide(next); }

  const lightbox=document.getElementById("lightbox");
  const lightboxImg=document.getElementById("lightboxImage");
  const lightboxCaption=document.getElementById("lightboxCaption");
  const images=Array.from(document.querySelectorAll(".slide-image-wrapper img"));
  const captions=Array.from(document.querySelectorAll(".gallery-caption"));

  function openLightbox(index){ if(!images.length) return; lightbox.style.display="flex"; updateLightbox(index); }
  function updateLightbox(index){
    const img=images[index]; const cap=captions[index];
    if(!img) return;
    lightboxImg.src=img.src;
    const lang=(document.documentElement.getAttribute("data-lang")||"en");
    const active=cap?cap.querySelector(".lang-"+lang):null;
    lightboxCaption.textContent=(active && active.textContent.trim())||"";
    currentIndex=index;
  }
  function changeLightbox(dir){ if(!images.length) return; const next=(currentIndex+dir+images.length)%images.length; updateLightbox(next); }
  function closeLightbox(){ lightbox.style.display="none"; }

  images.forEach((img,i)=>img.addEventListener("click",()=>openLightbox(i)));
  const sliderWindow=document.getElementById("sliderWindow");
  if(sliderWindow){
    let startX=0;
    sliderWindow.addEventListener("touchstart",e=>{startX=e.touches[0].clientX;},{passive:true});
    sliderWindow.addEventListener("touchend",e=>{
      const dx=e.changedTouches[0].clientX-startX;
      if(dx>50) moveSlide(-1); else if(dx<-50) moveSlide(1);
    },{passive:true});
  }
  document.addEventListener("keydown",e=>{
    if(lightbox && lightbox.style.display==="flex"){
      if(e.key==="Escape") closeLightbox();
      else if(e.key==="ArrowRight") changeLightbox(1);
      else if(e.key==="ArrowLeft") changeLightbox(-1);
    }
  });
  if(slides.length) showSlide(currentIndex);
</script>

{% endblock %}
