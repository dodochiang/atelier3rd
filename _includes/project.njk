{% extends "layout.njk" %}

{% block content %}
{# 英文 → 中文 類型對照 #}
{% set TYPE_ZH = {
  "Residential": "住宅",
  "Commercial": "商業",
  "Cultural": "文化",
  "Public": "公共",
  "Installation": "裝置",
  "Workshop": "工作營",
  "Exhibition": "展覽"
} %}

{% set TYPE_EN = {
  "住宅": "Residential",
  "商業": "Commercial",
  "文化": "Cultural",
  "公共": "Public",
  "裝置": "Installation",
  "工作營": "Workshop",
  "展覽": "Exhibition"
} %}

{# -------- 扁平欄位（不再支援 basic.*） -------- #}
{% set loc_en = location_en or location %}
{% set loc_zh = location_zh or location %}
{% set type_en = type %}
{% set type_zh_display = TYPE_ZH[type_en] or type_en %}

{# 縮圖路徑正規化（純 if/else） #}
{% set _thumb = thumbnail or '' %}
{% set heroSrc = '' %}
{% if _thumb %}
  {% if (_thumb | lower | slice(0,4)) == 'http' %}
    {% set heroSrc = _thumb %}
  {% else %}
    {% if _thumb[0] == '/' %}
      {% set heroSrc = _thumb %}
    {% else %}
      {% set heroSrc = '/' ~ _thumb %}
    {% endif %}
  {% endif %}
{% endif %}

<style>
  .project-hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 500px;
    overflow: hidden;
    position: relative;
    margin-bottom: 2.5em;
  }
  .project-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .project-title {
    text-align: center;
    font-size: 18pt;
    font-weight: bold;
    margin: 1em 0;
  }

  .project-section-title {
    text-align: center;
    font-size: 1.2em;
    font-weight: bold;
    margin: 2em 0 1em;
    color: #444;
  }

  .project-meta {
    text-align: center;
    font-size: 0.9em;
    color: gray;
    margin-bottom: 4em;
  }

  .project-content {
    max-width: 800px;
    margin: 0 auto 2em;
    line-height: 1.6;
  }

  .project-slider {
    max-width: 100%;
    margin: 2em auto;
    position: relative;
  }
  .slider-window { position: relative; }

  .slide { display: none; width: 100%; }
  .slide.active { display: block; }

  .slide-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;   /* 固定比例 */
    overflow: hidden;
  }
  .slide-image-wrapper img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;      /* 填滿裁切 */
    object-position: center;
    cursor: zoom-in;
  }

  .gallery-caption {
    margin-top: 0.5em;
    padding: 0.5em 1em;
    text-align: center;
    font-size: 0.85em;
    color: gray;
  }

  /* 左右箭頭置中在圖片區 */
  .slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.7);
    border: none;
    cursor: pointer;
    z-index: 2;
    line-height: 1;
    padding: 0.2em 0.5em;
    border-radius: .4em;
    font-size: 1.5em;
  }
  .slider-btn.prev {
    left: 1em; }
  .slider-btn.next { right: 1em; }

  .lightbox {
    display: none;
    position: fixed;
    z-index: 999;
    inset: 0;
    background: rgba(0,0,0,0.9);
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }
  .lightbox img {
    max-width: 90vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox-caption {
    color: white;
    margin-top: 1em;
    font-size: 0.9em;
    text-align: center;
    padding: 0 .75em;
  }
  .lightbox-controls {
    position: absolute;
    width: 100%;
    top: 50%;
    display: flex;
    justify-content: space-between;
    padding: 0 2em;
  }
  .lightbox-btn {
    color: white;
    font-size: 2em;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .lightbox-close {
    position: absolute;
    top: 1em;
    right: 2em;
    color: white;
    font-size: 2em;
    cursor: pointer;
  }

  .section-divider {
    border: none;
    border-top: 1px solid #ccc;
    margin: 5em auto;
    width: 60%;
  }

  .video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;   /* 固定比例 */
    overflow: hidden;
    max-height: 500px;     /* 限制高度 */
  }
  .video-container iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 600px) {
    .project-hero,
    .video-container {
      max-height: 300px;
    }

</style>

{% if heroSrc %}
  <div class="project-hero">
    <img src="{{ heroSrc | safe }}" alt="Project thumbnail">
  </div>
{% endif %}

<h1 class="project-title">
  <span class="lang-en">{{ title_en }}</span>
  <span class="lang-zh">{{ title_zh }}</span>
</h1>

{% set loc_en_safe = (loc_en or '') | replace(',', '&#44;') | safe %}
{% set loc_zh_safe = (loc_zh or '') | replace('，', '&#65292;') | replace(',', '&#44;') | safe %}

{% set _fa = floor_area %}
{% set _un = units %}

{% if _fa is not none %}
  {% set fa_str = (_fa ~ '') %}
  {% if ('㎡' in fa_str) or ('m²' in fa_str) or ('sqm' in (fa_str|lower)) %}
    {% set fa_en = fa_str %}{% set fa_zh = fa_str %}
  {% else %}
    {% set fa_en = fa_str ~ ' sqm' %}
    {% set fa_zh = fa_str ~ '㎡' %}
  {% endif %}
{% endif %}

{% if _un is not none %}
  {% set un_str = (_un ~ '') %}
  {% if ('戶' in un_str) or ('units' in (un_str|lower)) %}
    {% set units_en = un_str %}{% set units_zh = un_str %}
  {% else %}
    {% set units_en = un_str ~ ' units' %}
    {% set units_zh = un_str ~ '戶' %}
  {% endif %}
{% endif %}

<style>
  .project-meta-line { text-align:center; font-size:0.9em; color:gray; }
  .project-meta-line + .project-meta-line { margin-top:.25em; }
</style>

{# 第一行：類型｜地點 #}
<p class="project-meta-line">
  <span class="lang-en">
    {% if type_en %}{{ type_en }}{% endif %}
    {% if loc_en_safe %}｜{{ loc_en_safe }}{% endif %}
  </span>
  <span class="lang-zh">
    {% if type_zh_display %}{{ type_zh_display }}{% endif %}
    {% if loc_zh_safe %}｜{{ loc_zh_safe }}{% endif %}
  </span>
</p>

{# 第二行：戶數｜面積｜年份 #}
<p class="project-meta-line">
  <span class="lang-en">
    {% if units_en %}{{ units_en }}{% endif %}
    {% if fa_en %}｜{{ fa_en }}{% endif %}
    {% if year %}｜{{ year }}{% endif %}
  </span>
  <span class="lang-zh">
    {% if units_zh %}{{ units_zh }}{% endif %}
    {% if fa_zh %}｜{{ fa_zh }}{% endif %}
    {% if year %}｜{{ year }}{% endif %}
  </span>
</p>

<div class="project-content">
  <div class="lang-en">
    {{ body_en | markdown | safe }}
  </div>
  <div class="lang-zh">
    {{ body_zh | markdown | safe }}
  </div>
</div>

<hr class="section-divider">
{% if gallery %}
  <h2 class="project-section-title">
    <span class="lang-en">Project Gallery</span>
    <span class="lang-zh">項目照片</span>
  </h2>

  <div class="project-slider">
    <div class="slider-window" id="sliderWindow">
      {% for item in gallery %}
        {% set g = item %}
        {% set _img = g.image or '' %}
        {% set imgSrc = '' %}
        {% if _img %}
          {% if (_img | lower | slice(0,4)) == 'http' %}
            {% set imgSrc = _img %}
          {% else %}
            {% if _img[0] == '/' %}
              {% set imgSrc = _img %}
            {% else %}
              {% set imgSrc = '/' ~ _img %}
            {% endif %}
          {% endif %}
        {% endif %}

        <div class="slide{% if loop.first %} active{% endif %}">
          <div class="slide-image-wrapper">
            {% if imgSrc %}
              <img src="{{ imgSrc | safe }}" data-index="{{ loop.index0 }}" onclick="openLightbox({{ loop.index0 }})" loading="lazy" decoding="async">
            {% endif %}
          </div>
          <div class="gallery-caption">
            <span class="lang-en">{{ g.caption_en }}</span>
            <span class="lang-zh">{{ g.caption_zh }}</span>
          </div>
        </div>
      {% endfor %}

      <button class="slider-btn prev" onclick="moveSlide(-1)" aria-label="Previous">←</button>
      <button class="slider-btn next" onclick="moveSlide(1)" aria-label="Next">→</button>
    </div>
  </div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
    <div class="lightbox-controls">
      <button class="lightbox-btn" onclick="changeLightbox(-1)" aria-label="Previous">←</button>
      <button class="lightbox-btn" onclick="changeLightbox(1)" aria-label="Next">→</button>
    </div>
    <img id="lightboxImage" src="" alt="">
    <div class="lightbox-caption" id="lightboxCaption"></div>
    <div class="lightbox-close" onclick="closeLightbox()" aria-label="Close">×</div>
  </div>
{% endif %}

<hr class="section-divider">
{% if video %}
  <h2 class="project-section-title">
    <span class="lang-en">Project Video</span>
    <span class="lang-zh">項目影片</span>
  </h2>
  <div class="project-video" style="text-align: center; margin-top: 2em;">
    <div class="video-container">
      <iframe
        src="{{ video }}"
        title="YouTube video"
        frameborder="0"
        allowfullscreen
      ></iframe>
    </div>
  </div>
{% endif %}

<script>
  // Slides
  const slides = document.querySelectorAll(".slide");
  let currentIndex = 0;

  function showSlide(index) {
    slides.forEach((s, i) => s.classList.toggle("active", i === index));
    currentIndex = index;
  }
  function moveSlide(dir) {
    if (!slides.length) return;
    const next = (currentIndex + dir + slides.length) % slides.length;
    showSlide(next);
  }

  // Lightbox
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightboxImage");
  const lightboxCaption = document.getElementById("lightboxCaption");

  const images = Array.from(document.querySelectorAll(".slide-image-wrapper img"));
  const captions = Array.from(document.querySelectorAll(".gallery-caption"));

  function openLightbox(index) {
    if (!images.length) return;
    lightbox.style.display = "flex";
    updateLightbox(index);
  }
  function updateLightbox(index) {
    const img = images[index];
    const caption = captions[index];
    if (!img) return;
    lightboxImg.src = img.src;
    const currentLang = document.documentElement.getAttribute("data-lang") || "en";
    const activeCaption = caption ? caption.querySelector(`.lang-${currentLang}`) : null;
    lightboxCaption.textContent = (activeCaption && activeCaption.textContent.trim()) || "";
    currentIndex = index;
  }
  function changeLightbox(dir) {
    if (!images.length) return;
    const next = (currentIndex + dir + images.length) % images.length;
    updateLightbox(next);
  }
  function closeLightbox() { lightbox.style.display = "none"; }

  // 點擊圖片開啟 lightbox
  images.forEach((img, i) => img.addEventListener("click", () => openLightbox(i)));

  // Touch swipe on slider
  const sliderWindow = document.getElementById("sliderWindow");
  if (sliderWindow) {
    let startX = 0;
    sliderWindow.addEventListener("touchstart", e => { startX = e.touches[0].clientX; }, { passive: true });
    sliderWindow.addEventListener("touchend", e => {
      const deltaX = e.changedTouches[0].clientX - startX;
      if (deltaX > 50) moveSlide(-1);
      else if (deltaX < -50) moveSlide(1);
    }, { passive: true });
  }

  // 鍵盤支援：Esc 離開、左右切換
  document.addEventListener("keydown", function (e) {
    if (lightbox && lightbox.style.display === "flex") {
      if (e.key === "Escape") closeLightbox();
      else if (e.key === "ArrowRight") changeLightbox(1);
      else if (e.key === "ArrowLeft") changeLightbox(-1);
    }
  });

  // 初始化
  if (slides.length) showSlide(currentIndex);
</script>
{% endblock %}
