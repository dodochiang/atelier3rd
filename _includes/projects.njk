{% extends "layout.njk" %}

{% block content %}

{# 類型對照 #}
{% set TYPE_ZH = {
  "Residential": "住宅",
  "Commercial": "商業",
  "Cultural": "文化",
  "Public": "公共",
  "Installation": "裝置",
  "Workshop": "工作營",
  "Exhibition": "展覽"
} %}
{% set TYPE_EN = {
  "住宅": "Residential",
  "商業": "Commercial",
  "文化": "Cultural",
  "公共": "Public",
  "裝置": "Installation",
  "工作營": "Workshop",
  "展覽": "Exhibition"
} %}
{% set TYPE_OPTIONS = ["Residential","Commercial","Cultural","Public","Installation","Workshop","Exhibition"] %}

<style>
  .project a { text-decoration: none; color: inherit; }
  .project a:hover { text-decoration: none; color: inherit; }
  .projects-grid { max-width: 1000px; margin: 2em auto; padding: 1em; list-style: none; }
  .project-card { display: block; color: inherit; border: none; padding: 0; }
  .filters { margin: 1em 0; text-align: center; }
  .filters label, .filters select, .filters button { margin: 0 0.5em; }
  .project-title { text-align: center; font-size: 1em; font-weight: normal; margin: 1em 0; }
  .project-meta { text-align: center; font-size: 0.6em; color: #666; margin-top: 0.3em; font-variant-ligatures: none; }
  .project-meta-line { text-align:center; font-size:0.6em; color:#666; }
  .project-meta-line + .project-meta-line { margin-top:.2em; }
  .project-thumb { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; border: none; }
</style>

<section class="projects-page">
  <h1 class="project-title">
    <span class="lang-en">{{ title_en or "Projects" }}</span>
    <span class="lang-zh">{{ title_zh or "作品" }}</span>
  </h1>

  <div class="filters">
    <label for="typeFilter" id="typeFilterLabel">
      <span class="lang-en">Type:</span>
      <span class="lang-zh">類型：</span>
    </label>

    <select id="typeFilter">
      <option value="all" data-en="All" data-zh="全部">All</option>
      {% for t in TYPE_OPTIONS %}
        {% set t_zh = TYPE_ZH[t] or t %}
        <option value="{{ t }}" data-en="{{ t }}" data-zh="{{ t_zh }}">{{ t }}</option>
      {% endfor %}
    </select>

    <button id="sortDesc">
      <span class="lang lang-en">▼ Newest</span>
      <span class="lang lang-zh">▼ 最新</span>
    </button>
    <button id="sortAsc">
      <span class="lang lang-en">▲ Oldest</span>
      <span class="lang lang-zh">▲ 最舊</span>
    </button>
  </div>

  <ul class="grid projects-grid project-grid">
    {% for project in collections.projects %}
      {% set d = project.data %}

      {# 類型/地點 #}
      {% set rawType = d.type or '' %}
      {% set type_en = TYPE_EN[rawType] or rawType %}
      {% set type_zh = TYPE_ZH[type_en] or rawType %}
      {% set loc_en  = d.location_en or '' %}
      {% set loc_zh  = d.location_zh or '' %}

      {# --- 取得 thumbnail 原始字串（支援字串與 Cloudinary 物件） --- #}
      {% set _thumb = '' %}
      {% if d.thumbnail is string %}
        {% set _thumb = d.thumbnail %}
      {% elseif d.thumbnail %}
        {% if d.thumbnail.secure_url is defined and d.thumbnail.secure_url %}
          {% set _thumb = d.thumbnail.secure_url %}
        {% elif d.thumbnail.url is defined and d.thumbnail.url %}
          {% set _thumb = d.thumbnail.url %}
        {% elif d.thumbnail.path is defined and d.thumbnail.path %}
          {% set _thumb = d.thumbnail.path %}
        {% elif d.thumbnail.public_id is defined and d.thumbnail.public_id %}
          {# 只組合 public_id 與副檔名，不先加 Cloudinary 網域 #}
          {% set _ext = (d.thumbnail.extension is defined and d.thumbnail.extension) and ('.' ~ d.thumbnail.extension) or '' %}
          {% set _thumb = d.thumbnail.public_id ~ _ext %}
        {% endif %}
      {% endif %}

      {# --- 標準化成可用 URL（完整網址就原樣，避免再加一次前綴） --- #}
      {% set thumbSrc = _thumb | trim %}
      {% if thumbSrc %}
        {% set _low = thumbSrc | lower %}
        {% set _is_http      = (_low | slice(0,7))  == 'http://' %}
        {% set _is_https     = (_low | slice(0,8))  == 'https://' %}
        {% set _is_proto_rel = (thumbSrc | slice(0,2)) == '//' %}
        {% set _is_data      = (_low | slice(0,5))  == 'data:' %}
        {% set _is_abs       = (thumbSrc | slice(0,1)) == '/' %}
        {% set _is_uploads   = (_low | slice(0,8))  == 'uploads/' %}
        {% set _is_static_up = (_low | slice(0,15)) == 'static/uploads/' %}

        {% if _is_http or _is_https or _is_proto_rel or _is_data %}
          {# 已是完整網址/協定相對/data: → 原樣 #}
          {% set thumbSrc = thumbSrc %}
        {% elif _is_abs %}
          {# 站內絕對路徑 → 原樣 #}
          {% set thumbSrc = thumbSrc %}
        {% elif _is_uploads or _is_static_up %}
          {# 站內相對 uploads → 補一個 / #}
          {% set thumbSrc = '/' ~ thumbSrc %}
        {% else %}
          {# 其他（public_id 或單純檔名）→ 單次加 Cloudinary 前綴 #}
          {% if (thumbSrc | slice(0,1)) == '/' %}
            {% set thumbSrc = thumbSrc | slice(1) %}
          {% endif %}
          {% set thumbSrc = 'https://res.cloudinary.com/dw6nekwxn/image/upload/' ~ thumbSrc %}
        {% endif %}
      {% endif %}

      {# 面積/戶數 #}
      {% set _fa = d.floor_area %}
      {% set _un = d.units %}
      {% if _fa is not none %}
        {% set fa_str = (_fa ~ '') %}
        {% if ('㎡' in fa_str) or ('m²' in fa_str) or ('sqm' in (fa_str|lower)) %}
          {% set fa_en = fa_str %}{% set fa_zh = fa_str %}
        {% else %}
          {% set fa_en = fa_str ~ ' sqm' %}
          {% set fa_zh = fa_str ~ '㎡' %}
        {% endif %}
      {% endif %}
      {% if _un is not none %}
        {% set un_str = (_un ~ '') %}
        {% if ('戶' in un_str) or ('units' in (un_str|lower)) %}
          {% set units_en = un_str %}{% set units_zh = un_str %}
        {% else %}
          {% set units_en = un_str ~ ' units' %}
          {% set units_zh = un_str ~ '戶' %}
        {% endif %}
      {% endif %}

      <li class="project"
          data-year="{{ d.year }}"
          data-type="{{ type_en }}"
          data-type-en="{{ type_en }}"
          data-type-zh="{{ type_zh }}"
          data-location-en="{{ loc_en }}"
          data-location-zh="{{ loc_zh }}">
        <a href="{{ project.url }}" class="project-card">
          {% if thumbSrc %}
            <img class="project-thumb"
                 src="{{ thumbSrc | safe }}"
                 alt="{{ d.title_en or d.title_zh }} — thumbnail"
                 loading="lazy" decoding="async"
                 referrerpolicy="no-referrer-when-downgrade">
          {% endif %}

          <div class="project-title">
            <span class="lang-en">{{ d.title_en }}</span>
            <span class="lang-zh">{{ d.title_zh }}</span>
          </div>

          <div class="project-meta">
            <div class="project-meta-line">
              <span class="lang-en">
                {% if type_en %}{{ type_en }}{% endif %}{% if loc_en %} ｜ {{ loc_en }}{% endif %}
              </span>
              <span class="lang-zh">
                {% if type_zh %}{{ type_zh }}{% endif %}{% if loc_zh %} ｜ {{ loc_zh }}{% endif %}
              </span>
            </div>
            <div class="project-meta-line">
              <span class="lang-en">
                {% if units_en %}{{ units_en }}{% endif %}{% if fa_en %} ｜ {{ fa_en }}{% endif %}{% if d.year %} ｜ {{ d.year }}{% endif %}
              </span>
              <span class="lang-zh">
                {% if units_zh %}{{ units_zh }}{% endif %}{% if fa_zh %} ｜ {{ fa_zh }}{% endif %}{% if d.year %} ｜ {{ d.year }}{% endif %}
              </span>
            </div>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));

    const typeFilter = $("#typeFilter");
    const projectList = $(".project-grid");
    const projects = $$(".project-grid > .project");

    function getLang() {
      let v = (localStorage.getItem("lang") || "").toLowerCase();
      if (v === "lang-en") v = "en";
      if (v === "lang-zh") v = "zh";
      if (v !== "en" && v !== "zh") {
        if (document.documentElement.classList.contains("lang-zh") || document.body.classList.contains("lang-zh")) v = "zh";
        else if (document.documentElement.classList.contains("lang-en") || document.body.classList.contains("lang-en")) v = "en";
        else v = "en";
      }
      return v;
    }

    function applyTypeI18n() {
      const lang = getLang();
      const label = $("#typeFilterLabel");
      if (label) {
        $$(".lang-en", label).forEach(el => el.style.display = (lang === "en" ? "" : "none"));
        $$(".lang-zh", label).forEach(el => el.style.display = (lang === "zh" ? "" : "none"));
      }
      $$("#typeFilter option").forEach(opt => {
        const txt = opt.dataset[lang];
        if (txt) opt.textContent = txt;
      });
    }

    function filterAndSort(order = "desc") {
      const selectedVal = typeFilter.value;
      const filtered = projects.filter(project => selectedVal === "all" ? true : (project.dataset.typeEn === selectedVal));
      filtered.sort((a, b) => {
        const aYear = parseInt(a.dataset.year || "0", 10);
        const bYear = parseInt(b.dataset.year || "0", 10);
        return order === "asc" ? aYear - bYear : bYear - aYear;
      });
      projectList.innerHTML = "";
      filtered.forEach(p => projectList.appendChild(p));
    }

    typeFilter.addEventListener("change", () => filterAndSort(currentOrder));
    let currentOrder = "desc";
    $("#sortAsc").addEventListener("click", () => { currentOrder = "asc"; filterAndSort("asc"); });
    $("#sortDesc").addEventListener("click", () => { currentOrder = "desc"; filterAndSort("desc"); });

    applyTypeI18n();
    filterAndSort("desc");

    const observer = new MutationObserver(() => { applyTypeI18n(); filterAndSort(currentOrder); });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
    observer.observe(document.body, { attributes: true, attributeFilter: ["class"] });

    window.addEventListener("storage", (e) => {
      if (e.key === "lang") { applyTypeI18n(); filterAndSort(currentOrder); }
    });
  });
</script>

{% endblock %}
