{% extends "layout.njk" %}

{% block content %}

{# ===== 類型對照 ===== #}
{% set TYPE_ZH = {
  "Residential": "住宅",
  "Commercial": "商業",
  "Cultural": "文化",
  "Public": "公共",
  "Installation": "裝置",
  "Workshop": "工作營",
  "Exhibition": "展覽"
} %}
{% set TYPE_EN = {
  "住宅": "Residential",
  "商業": "Commercial",
  "文化": "Cultural",
  "公共": "Public",
  "裝置": "Installation",
  "工作營": "Workshop",
  "展覽": "Exhibition"
} %}

<style>
  /* links inside each project card */
  .project a { text-decoration: none; color: inherit; }
  .project a:hover { text-decoration: none; color: inherit; }

  /* ===== Responsive projects grid ===== */
  .projects-grid {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1em;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 2em;
  }

  @media (max-width: 1200px) {
    .projects-grid { grid-template-columns: repeat(4, 1fr); gap: 1.5em; }
  }
  @media (max-width: 1024px) {
    .projects-grid { grid-template-columns: repeat(3, 1fr); gap: 1.25em; }
  }
  @media (max-width: 768px) {
    .projects-grid { grid-template-columns: repeat(2, 1fr); gap: 1em; padding: .75em; }
  }
  @media (max-width: 480px) {
    .projects-grid { grid-template-columns: 1fr; gap: .85em; padding: .6em; }
  }

  .project-card { display: block; color: inherit; border: none; padding: 0; }

  .project-thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border: none;
  }

  /* ===== Title & meta: language-locked (no layout shift on toggle) ===== */
  .lock-lang { position: relative; }
  .lock-lang .lang-en,
  .lock-lang .lang-zh {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
  }
  html[data-lang='en'] .lock-lang .lang-en { opacity: 1; visibility: visible; }
  html[data-lang='zh'] .lock-lang .lang-zh { opacity: 1; visibility: visible; }

  /* ===== Card title: center, max 2 lines for EN, fixed height ===== */
  .project-title {
    margin: .6em 0 0;
    font-weight: normal;
    color: #333;
    line-height: 1.25;
    min-height: calc(1em * 1.25 * 2); /* ≈ two lines */
  }
  .project-title .lang-en,
  .project-title .lang-zh {
    padding: 0 .25em; /* tiny side padding for nicer clamp on mobile */
    text-align: center;
  }
  .project-title .lang-en {
    font-size: 1em;
    /* clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    max-height: calc(1em * 1.25 * 2);
    overflow: hidden;
    word-break: break-word;
    color: #444;
  }
  .project-title .lang-zh {
    font-size: 1em;
    color: #555;
  }

  /* ===== Meta: CN a bit larger than EN, keep centered ===== */
  .project-meta {
    margin-top: .25em;
    text-align: center;
    color: #666;
    font-variant-ligatures: none;
    min-height: 2.6em; /* keeps row stable across EN/ZH */
  }
  .project-meta .project-meta-line { margin-top: .15em; }
  .project-meta .lang-zh { font-size: .9em; }
  .project-meta .lang-en { font-size: .9em; opacity: .95; }

  /* ===== Mobile type ramp (bigger, easier to read) ===== */
  @media (max-width: 768px) {
    .project-title { min-height: calc(1.1em * 1.3 * 2); }
    .project-title .lang-en, .project-title .lang-zh { font-size: 1.05em; }
    .project-meta .lang-zh { font-size: .95em; }
    .project-meta .lang-en { font-size: .9em; }
  }
  @media (max-width: 480px) {
    .project-title .lang-en, .project-title .lang-zh { font-size: 1.12em; }
    .project-meta .lang-zh { font-size: 1em; }
    .project-meta .lang-en { font-size: .95em; }
  }

  /* Optional: make the global type chips in subnav scrollable on small screens */
  @media (max-width: 768px) {
    .subnav .chip-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      gap: .6em;
    }
    .subnav .chip { white-space: nowrap; flex: 0 0 auto; }
  }
</style>

<section class="projects-page">
  <ul class="projects-grid project-grid">
    {% for project in collections.projects %}
      {% set d = project.data %}

      {# 類型/地點：標準化為英文，再反查中文 #}
      {% set rawType = d.type or '' %}
      {% set type_en = TYPE_EN[rawType] or rawType %}
      {% set type_zh = TYPE_ZH[type_en] or (TYPE_ZH[rawType] or rawType) %}
      {% set loc_en  = d.location_en or d.location or '' %}
      {% set loc_zh  = d.location_zh or d.location or '' %}

      {# 地區推論（taiwan / china / overseas） #}
      {% set _loc_zh = (loc_zh or '') | lower %}
      {% set _loc_en = (loc_en or '') | lower %}
      {% set region = '' %}
      {% if '台灣' in _loc_zh or '臺灣' in _loc_zh or 'taiwan' in _loc_en %}
        {% set region = 'taiwan' %}
      {% elif '中國' in _loc_zh or 'china' in _loc_en %}
        {% set region = 'china' %}
      {% else %}
        {% set region = 'overseas' %}
      {% endif %}

      {# 縮圖：若是陣列取第一張；支援字串/Cloudinary 物件 #}
      {% set tn = d.thumbnail %}
      {% if tn and (tn[0] is defined) %}
        {% set tn = tn[0] %}
      {% endif %}

      {% set thumb = '' %}
      {% if tn is string %}
        {% set thumb = tn %}
      {% elseif tn %}
        {% if tn.secure_url is defined and tn.secure_url %}
          {% set thumb = tn.secure_url %}
        {% elif tn.url is defined and tn.url %}
          {% set thumb = tn.url %}
        {% elif tn.path is defined and tn.path %}
          {% set thumb = tn.path %}
        {% elif tn.public_id is defined and tn.public_id %}
          {% set ext = (tn.extension is defined and tn.extension) and ('.' ~ tn.extension) or '' %}
          {% set thumb = 'https://res.cloudinary.com/dw6nekwxn/image/upload/' ~ tn.public_id ~ ext %}
        {% endif %}
      {% endif %}

      {# 正規化（不主動加 Cloudinary；僅本地 uploads 前加 /） #}
      {% set thumbSrc = (thumb or '') | trim %}
      {% if thumbSrc %}
        {% set low = thumbSrc | lower %}
        {% if (low | slice(0,7)) == 'http://' or (low | slice(0,8)) == 'https://' or (thumbSrc | slice(0,2)) == '//' or (low | slice(0,5)) == 'data:' %}
          {% set thumbSrc = thumbSrc %}
        {% elif (thumbSrc | slice(0,1)) == '/' %}
          {% set thumbSrc = thumbSrc %}
        {% elif (low | slice(0,8)) == 'uploads/' or (low | slice(0,15)) == 'static/uploads/' %}
          {% set thumbSrc = '/' ~ thumbSrc %}
        {% else %}
          {% set thumbSrc = thumbSrc %}
        {% endif %}
        {% set cloudPrefix = 'https://res.cloudinary.com/dw6nekwxn/image/upload/' %}
        {% set thumbSrc = thumbSrc
          | replace(cloudPrefix ~ 'https://', 'https://')
          | replace(cloudPrefix ~ 'http://', 'http://')
          | replace('image/upload//', 'image/upload/') %}
      {% endif %}

      {# 面積/戶數（中英後綴） #}
      {% set _fa = d.floor_area %}
      {% set _un = d.units %}
      {% if _fa is not none %}
        {% set fa_str = (_fa ~ '') %}
        {% if ('㎡' in fa_str) or ('m²' in fa_str) or ('sqm' in (fa_str|lower)) %}
          {% set fa_en = fa_str %}{% set fa_zh = fa_str %}
        {% else %}
          {% set fa_en = fa_str ~ ' sqm' %}
          {% set fa_zh = fa_str ~ '㎡' %}
        {% endif %}
      {% endif %}
      {% if _un is not none %}
        {% set un_str = (_un ~ '') %}
        {% if ('戶' in un_str) or ('units' in (un_str|lower)) %}
          {% set units_en = un_str %}{% set units_zh = un_str %}
        {% else %}
          {% set units_en = un_str ~ ' units' %}
          {% set units_zh = un_str ~ '戶' %}
        {% endif %}
      {% endif %}

      <li class="project"
          data-year="{{ d.year }}"
          data-type="{{ type_en }}"
          data-type-en="{{ type_en }}"
          data-type-zh="{{ type_zh }}"
          data-location-en="{{ loc_en }}"
          data-location-zh="{{ loc_zh }}"
          data-region="{{ region }}">
        <a href="{{ project.url }}" class="project-card">
          {% if thumbSrc %}
            <img class="project-thumb"
                 src="{{ thumbSrc | safe }}"
                 alt="{{ d.title_en or d.title_zh }} — thumbnail"
                 loading="lazy" decoding="async"
                 referrerpolicy="no-referrer-when-downgrade">
          {% endif %}

          <div class="project-title lock-lang">
            <span class="lang-en">{{ d.title_en }}</span>
            <span class="lang-zh">{{ d.title_zh }}</span>
          </div>

          <div class="project-meta lock-lang">
            <div class="project-meta-line">
              <span class="lang-en">
                {% if type_en %}{{ type_en }}{% endif %}{% if loc_en %} ｜ {{ loc_en }}{% endif %}
              </span>
              <span class="lang-zh">
                {% if type_zh %}{{ type_zh }}{% endif %}{% if loc_zh %} ｜ {{ loc_zh }}{% endif %}
              </span>
            </div>
            <div class="project-meta-line">
              <span class="lang-en">
                {% if units_en %}{{ units_en }}{% endif %}{% if fa_en %} ｜ {{ fa_en }}{% endif %}{% if d.year %} ｜ {{ d.year }}{% endif %}
              </span>
              <span class="lang-zh">
                {% if units_zh %}{{ units_zh }}{% endif %}{% if fa_zh %} ｜ {{ fa_zh }}{% endif %}{% if d.year %} ｜ {{ d.year }}{% endif %}
              </span>
            </div>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

{% endblock %}
