{% extends "layout.njk" %}

{% block content %}

{# 類型對照 #}
{% set TYPE_ZH = {
  "Residential": "住宅",
  "Commercial": "商業",
  "Cultural": "文化",
  "Public": "公共",
  "Installation": "裝置",
  "Workshop": "工作營",
  "Exhibition": "展覽"
} %}
{% set TYPE_EN = {
  "住宅": "Residential",
  "商業": "Commercial",
  "文化": "Cultural",
  "公共": "Public",
  "裝置": "Installation",
  "工作營": "Workshop",
  "展覽": "Exhibition"
} %}

<style>
  .project a { text-decoration: none; color: inherit; }
  .project a:hover { text-decoration: none; color: inherit; }

  .projects-grid {
    max-width: 1000px;
    margin: 2em auto;
    padding: 1em;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1em;
  }

  .project-card { display: block; color: inherit; border: none; padding: 0; }

  .page-title {
    text-align: center;
    font-size: 0.9em;
    font-weight: normal;
    margin: 1em 0;
  }

  /* Project title 英文靠左對齊 */
  .project-title .lang-en {
    display: block;       /* 讓英文獨佔一行，避免受中文影響 */
    font-size: 0.8em;     /* 小一點 */
  }

  /* 中文維持原本對齊與大小 */
  .project-title .lang-zh {
    display: block;
    font-size: 1em;
  }
  .project-meta {
    text-align: center;
    font-size: 0.9em;
    color: #666;
    margin-top: 0.5em;
    font-variant-ligatures: none;
  }

  .project-meta .lang-en {
    font-size: 0.8em;\ /* 英文再小一點 */
  }
  .project-meta .lang-zh {
    font-size: 0.9em; /* 中文稍微大一點 */
  }
  .project-meta-line { text-align:center; font-size:0.9em; color:#666; }
  .project-meta-line + .project-meta-line { margin-top:.1em; }

  .project-thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border: none;
  }
</style>

<section class="projects-page">
  <h1 class="page-title">
    <span class="lang-en">{{ title_en or "Projects" }}</span>
    <span class="lang-zh">{{ title_zh or "作品" }}</span>
  </h1>

  {# 沒有任何本頁面的下拉/按鈕；由 layout.njk 的第二層 navbar 控制 #}

  <ul class="projects-grid project-grid">
    {% for project in collections.projects %}
      {% set d = project.data %}

      {# 類型/地點 #}
      {% set rawType = d.type or '' %}
      {% set type_en = TYPE_EN[rawType] or rawType %}
      {% set type_zh = TYPE_ZH[type_en] or rawType %}
      {% set loc_en  = d.location_en or '' %}
      {% set loc_zh  = d.location_zh or '' %}

      {# 取出縮圖（支援字串、Cloudinary 物件） #}
      {% set thumb = '' %}
      {% if d.thumbnail is string %}
        {% set thumb = d.thumbnail %}
      {% elseif d.thumbnail %}
        {% if d.thumbnail.secure_url is defined and d.thumbnail.secure_url %}
          {% set thumb = d.thumbnail.secure_url %}
        {% elif d.thumbnail.url is defined and d.thumbnail.url %}
          {% set thumb = d.thumbnail.url %}
        {% elif d.thumbnail.path is defined and d.thumbnail.path %}
          {% set thumb = d.thumbnail.path %}
        {% elif d.thumbnail.public_id is defined and d.thumbnail.public_id %}
          {# 只有 public_id 才組一次 Cloudinary 前綴 #}
          {% set ext = (d.thumbnail.extension is defined and d.thumbnail.extension) and ('.' ~ d.thumbnail.extension) or '' %}
          {% set thumb = 'https://res.cloudinary.com/dw6nekwxn/image/upload/' ~ d.thumbnail.public_id ~ ext %}
        {% endif %}
      {% endif %}

      {# 正規化（不主動加 Cloudinary；只處理本地 uploads → 加一個/） #}
      {% set thumbSrc = (thumb or '') | trim %}
      {% if thumbSrc %}
        {% set low = thumbSrc | lower %}
        {% if (low | slice(0,7)) == 'http://' or (low | slice(0,8)) == 'https://' or (thumbSrc | slice(0,2)) == '//' or (low | slice(0,5)) == 'data:' %}
          {% set thumbSrc = thumbSrc %}
        {% elif (thumbSrc | slice(0,1)) == '/' %}
          {% set thumbSrc = thumbSrc %}
        {% elif (low | slice(0,8)) == 'uploads/' or (low | slice(0,15)) == 'static/uploads/' %}
          {% set thumbSrc = '/' ~ thumbSrc %}
        {% else %}
          {% set thumbSrc = thumbSrc %}
        {% endif %}

        {# 防呆：去掉 Cloudinary 雙前綴、雙斜線 #}
        {% set cloudPrefix = 'https://res.cloudinary.com/dw6nekwxn/image/upload/' %}
        {% set thumbSrc = thumbSrc
          | replace(cloudPrefix ~ 'https://', 'https://')
          | replace(cloudPrefix ~ 'http://', 'http://')
          | replace('image/upload//', 'image/upload/') %}
      {% endif %}

      {# 面積/戶數 #}
      {% set _fa = d.floor_area %}
      {% set _un = d.units %}
      {% if _fa is not none %}
        {% set fa_str = (_fa ~ '') %}
        {% if ('㎡' in fa_str) or ('m²' in fa_str) or ('sqm' in (fa_str|lower)) %}
          {% set fa_en = fa_str %}{% set fa_zh = fa_str %}
        {% else %}
          {% set fa_en = fa_str ~ ' sqm' %}
          {% set fa_zh = fa_str ~ '㎡' %}
        {% endif %}
      {% endif %}
      {% if _un is not none %}
        {% set un_str = (_un ~ '') %}
        {% if ('戶' in un_str) or ('units' in (un_str|lower)) %}
          {% set units_en = un_str %}{% set units_zh = un_str %}
        {% else %}
          {% set units_en = un_str ~ ' units' %}
          {% set units_zh = un_str ~ '戶' %}
        {% endif %}
      {% endif %}

      {# data-region：先讀 d.region，其次用地點推論 #}
      {% set region = (d.region or '') | lower %}
      {% if not region %}
        {% set name_zh = (d.location_zh or '') | lower %}
        {% set name_en = (d.location_en or '') | lower %}
        {% if '台灣' in name_zh or '臺灣' in name_zh or 'taiwan' in name_en %}
          {% set region = 'taiwan' %}
        {% elif '中國' in name_zh or 'china' in name_en %}
          {% set region = 'china' %}
        {% else %}
          {% set region = 'overseas' %}
        {% endif %}
      {% endif %}

      <li class="project"
          data-year="{{ d.year }}"
          data-type="{{ type_en }}"
          data-type-en="{{ type_en }}"
          data-type-zh="{{ type_zh }}"
          data-location-en="{{ loc_en }}"
          data-location-zh="{{ loc_zh }}"
          data-region="{{ region }}">
        <a href="{{ project.url }}" class="project-card">
          {% if thumbSrc %}
            <img class="project-thumb"
                 src="{{ thumbSrc | safe }}"
                 alt="{{ d.title_en or d.title_zh }} — thumbnail"
                 loading="lazy" decoding="async"
                 referrerpolicy="no-referrer-when-downgrade">
          {% endif %}

          <div class="project-title">
            <span class="lang-en">{{ d.title_en }}</span>
            <span class="lang-zh">{{ d.title_zh }}</span>
          </div>

          <div class="project-meta">
            <div class="project-meta-line">
              <span class="lang-en">
                {% if type_en %}{{ type_en }}{% endif %}{% if loc_en %} ｜ {{ loc_en }}{% endif %}
              </span>
              <span class="lang-zh">
                {% if type_zh %}{{ type_zh }}{% endif %}{% if loc_zh %} ｜ {{ loc_zh }}{% endif %}
              </span>
            </div>
            <div class="project-meta-line">
              <span class="lang-en">
                {% if units_en %}{{ units_en }}{% endif %}{% if fa_en %} ｜ {{ fa_en }}{% endif %}{% if d.year %} ｜ {{ d.year }}{% endif %}
              </span>
              <span class="lang-zh">
                {% if units_zh %}{{ units_zh }}{% endif %}{% if fa_zh %} ｜ {{ fa_zh }}{% endif %}{% if d.year %} ｜ {{ d.year }}{% endif %}
              </span>
            </div>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

{% endblock %}
