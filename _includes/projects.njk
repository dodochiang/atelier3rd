{% extends "layout.njk" %}

{% block content %}

{# 英文 → 中文 類型對照 #}
{% set TYPE_ZH = {
  "Residential": "住宅",
  "Commercial": "商業",
  "Cultural": "文化",
  "Public": "公共",
  "Installation": "裝置",
  "Workshops & Exhibition": "工作營及展覽"
} %}

{# 蒐集不重複的 type 清單 #}
{% set typeList = [] %}
{% for p in collections.projects %}
  {% set t = p.data.type %}
  {% if t and (typeList.indexOf(t) == -1) %}
    {% set typeList = typeList.concat([t]) %}
  {% endif %}
{% endfor %}

<style>
  .project a { text-decoration: none; color: inherit; }
  .project a:hover { text-decoration: none; color: inherit; }

  .projects-grid {
    max-width: 1000px;
    margin: 2em auto;
    padding: 1em;
    list-style: none;
  }

  .project-card { display: block; color: inherit; border: none; padding: 0; }

  .filters { margin: 1em 0; text-align: center; }
  .filters label, .filters select, .filters button { margin: 0 0.5em; }

  .project-title {
    text-align: center;
    font-size: 1.2em;
    font-weight: bold;
    margin: 1em 0;
  }

  .project-meta {
    text-align: center;
    font-size: 0.8em;
    color: #666;
    margin-top: 0.3em;
  }

  .project-thumb img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border: none;
  }
</style>

<section class="projects-page">
  <h1 class="project-title">
    <span class="lang-en">{{ title_en or "Projects" }}</span>
    <span class="lang-zh">{{ title_zh or "作品" }}</span>
  </h1>

  <div class="filters">
    <label for="typeFilter" id="typeFilterLabel">Type:</label>
    <select id="typeFilter">
      <option value="all" data-en="All" data-zh="全部">All</option>
      {% for t in typeList %}
        <option
          value="{{ t }}"
          data-en="{{ t }}"
          data-zh="{{ TYPE_ZH[t] or t }}"
        >{{ t }}</option>
      {% endfor %}
    </select>

    <button id="sortDesc">
      <span class="lang lang-en">▼ Newest</span>
      <span class="lang lang-zh">▼ 最新</span>
    </button>
    <button id="sortAsc">
      <span class="lang lang-en">▲ Oldest</span>
      <span class="lang lang-zh">▲ 最舊</span>
    </button>
  </div>

  <ul class="grid projects-grid project-grid">
    {% for project in collections.projects %}
      {% set d = project.data %}

      {# 縮圖路徑正規化：支援絕對網址與本地路徑 #}
      {% set thumb = d.thumbnail or '' %}
      {% set thumbSrc = '' %}
      {% if thumb %}
        {% if (thumb | lower | slice(0,4)) == 'http' %}
          {% set thumbSrc = thumb %}
        {% else %}
          {% if thumb[0] == '/' %}
            {% set thumbSrc = thumb %}
          {% else %}
            {% set thumbSrc = '/' ~ thumb %}
          {% endif %}
        {% endif %}
      {% endif %}

      <li class="project"
          data-year="{{ d.year }}"
          data-type="{{ d.type }}"
          data-location="{{ d.location_en }}">
        <a href="{{ project.url }}" class="project-card">
          {% if thumbSrc %}
            <img src="{{ thumbSrc | safe }}" alt="{{ d.title_en or d.title_zh }} — thumbnail" loading="lazy" decoding="async">
          {% endif %}

          <div class="project-title">
            <span class="lang-en">{{ d.title_en }}</span>
            <span class="lang-zh">{{ d.title_zh }}</span>
          </div>

          <div class="project-meta">
            <span class="lang-en">
              {{ d.year }}{% if d.location_en %} | {{ d.location_en }}{% endif %}{% if d.type %} | {{ d.type }}{% endif %}
            </span>
            <span class="lang-zh">
              {{ d.year }}{% if d.location_zh %} | {{ d.location_zh }}{% endif %}{% if d.type %} | {{ TYPE_ZH[d.type] or d.type }}{% endif %}
            </span>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const typeFilter = document.getElementById("typeFilter");
    const typeFilterLabel = document.getElementById("typeFilterLabel");
    const sortAscBtn = document.getElementById("sortAsc");
    const sortDescBtn = document.getElementById("sortDesc");
    const projectList = document.querySelector(".project-grid");
    const projects = Array.from(projectList.children);

    function filterAndSort(order = "desc") {
      const selectedType = typeFilter.value;

      const filtered = projects.filter(project =>
        selectedType === "all" || project.dataset.type === selectedType
      );

      filtered.sort((a, b) => {
        const aYear = parseInt(a.dataset.year || "0", 10);
        const bYear = parseInt(b.dataset.year || "0", 10);
        return order === "asc" ? aYear - bYear : bYear - aYear;
      });

      projectList.innerHTML = "";
      filtered.forEach(p => projectList.appendChild(p));
    }

    typeFilter.addEventListener("change", () => filterAndSort());
    sortAscBtn.addEventListener("click", () => filterAndSort("asc"));
    sortDescBtn.addEventListener("click", () => filterAndSort("desc"));

    // 初始化排序
    filterAndSort("desc");

    // 多語言處理：option 和 label
    const lang = localStorage.getItem("lang") || "en";
    document.querySelectorAll("#typeFilter option").forEach(opt => {
      if (opt.dataset[lang]) opt.textContent = opt.dataset[lang];
    });
    if (typeFilterLabel) {
      typeFilterLabel.textContent = lang === "zh" ? "類型：" : "Type:";
    }
  });
</script>

{% endblock %}
