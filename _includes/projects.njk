{% extends "layout.njk" %}

{% block content %}

{# 建出可用的 type/type_zh 配對（去重、略過空值） #}
{% set typePairs = [] %}
{% for project in collections.projects %}
  {% set d = project.data %}
  {% set type = d.type %}
  {% set type_zh = d.type_zh %}
  {% if type %}
    {% set exists = false %}
    {% for pair in typePairs %}
      {% if pair.type == type %}
        {% set exists = true %}
      {% endif %}
    {% endfor %}
    {% if not exists %}
      {% set typePairs = typePairs.concat([{ "type": type, "type_zh": type_zh }]) %}
    {% endif %}
  {% endif %}
{% endfor %}

<style>
  .project a {
    text-decoration: none;
    color: inherit;
  }
  .project a:hover {
    text-decoration: none;
    color: inherit;
  }
  .projects-grid {
    max-width: 1000px;
    margin: 2em auto;
    padding: 1em;
    list-style: none;
  }
  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: none;
    padding: 0;
  }
  .filters {
    margin: 1em 0;
    text-align: center;
  }
  .filters label,
  .filters select,
  .filters button {
    margin: 0 0.5em;
  }
  .project-title {
    text-align: center;
    font-size: 1.2em;
    font-weight: bold;
    margin: 1em 0;
  }
  .project-meta {
    text-align: center;
    font-size: 0.8em;
    color: #666;
    margin-top: 0.3em;
  }
  .project-thumb img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border: none;
  }
</style>

<section class="projects-page">
  <h1 class="project-title">
    <span class="lang-en">{{ title_en or "Projects" }}</span>
    <span class="lang-zh">{{ title_zh or "作品" }}</span>
  </h1>

  <div class="filters">
    <label for="typeFilter" id="typeFilterLabel">Type:</label>
    <select id="typeFilter">
      <option value="all" data-en="All" data-zh="全部">All</option>
      {% for pair in typePairs %}
        <option value="{{ pair.type }}" data-en="{{ pair.type }}" data-zh="{{ pair.type_zh }}">{{ pair.type }}</option>
      {% endfor %}
    </select>

    <button id="sortDesc">
      <span class="lang lang-en">▼ Newest</span>
      <span class="lang lang-zh">▼ 最新</span>
    </button>
    <button id="sortAsc">
      <span class="lang lang-en">▲ Oldest</span>
      <span class="lang lang-zh">▲ 最舊</span>
    </button>
  </div>

  <ul class="grid projects-grid project-grid">
    {% for project in collections.projects %}
      {# 讀取資料並做 fallback：相容 basic.* 與扁平欄位 #}
      {% set d = project.data %}
      {% set title_en = (d.basic and d.basic.title_en) or d.title_en %}
      {% set title_zh = (d.basic and d.basic.title_zh) or d.title_zh %}
      {% set year     = (d.basic and d.basic.year)     or d.year %}
      {% set type_en  = d.type %}
      {% set type_zh  = d.type_zh %}
      {% set loc_en   = d.location_en or d.location %}
      {% set loc_zh   = d.location_zh or d.location %}

      {# 縮圖路徑正規化：支援絕對網址與本地 /uploads #}
      {% set thumb = d.thumbnail or '' %}
      {% set thumbSrc = '' %}
      {% if thumb %}
        {# http / https 視為絕對網址 #}
        {% if (thumb | lower | slice(0,4)) == 'http' %}
          {% set thumbSrc = thumb %}
        {% else %}
          {% if thumb[0] == '/' %}
            {% set thumbSrc = thumb %}
          {% else %}
            {% set thumbSrc = '/' ~ thumb %}
          {% endif %}
        {% endif %}
      {% endif %}

      <li class="project"
          data-year="{{ year }}"
          data-type="{{ type_en }}"
          data-location="{{ loc_en }}">
        <a href="{{ project.url }}" class="project-card">
          {% if thumbSrc %}
            <img src="{{ thumbSrc | safe }}" alt="{{ title_en or title_zh }} — thumbnail" loading="lazy" decoding="async">
          {% endif %}
          <div class="project-title">
            <span class="lang-en">{{ title_en }}</span>
            <span class="lang-zh">{{ title_zh }}</span>
          </div>
          <div class="project-meta">
            <span class="lang-en">
              {{ year }}{% if loc_en %} | {{ loc_en }}{% endif %}{% if type_en %} | {{ type_en }}{% endif %}
            </span>
            <span class="lang-zh">
              {{ year }}{% if loc_zh %} | {{ loc_zh }}{% endif %}{% if type_zh %} | {{ type_zh }}{% endif %}
            </span>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const typeFilter = document.getElementById("typeFilter");
    const typeFilterLabel = document.getElementById("typeFilterLabel");
    const sortAscBtn = document.getElementById("sortAsc");
    const sortDescBtn = document.getElementById("sortDesc");
    const projectList = document.querySelector(".project-grid");
    let projects = Array.from(projectList.children);

    function filterAndSort(order = "desc") {
      const selectedType = typeFilter.value;

      let filtered = projects.filter(project => {
        return selectedType === "all" || project.dataset.type === selectedType;
      });

      filtered.sort((a, b) => {
        const aYear = parseInt(a.dataset.year || "0", 10);
        const bYear = parseInt(b.dataset.year || "0", 10);
        return order === "asc" ? aYear - bYear : bYear - aYear;
      });

      projectList.innerHTML = "";
      filtered.forEach(p => projectList.appendChild(p));
    }

    typeFilter.addEventListener("change", () => filterAndSort());
    sortAscBtn.addEventListener("click", () => filterAndSort("asc"));
    sortDescBtn.addEventListener("click", () => filterAndSort("desc"));

    filterAndSort("desc"); // 預設

    // 多語言處理：按鈕、option、label
    const lang = localStorage.getItem("lang") || "en";
    document.querySelectorAll("#typeFilter option").forEach(opt => {
      if (opt.dataset[lang]) opt.textContent = opt.dataset[lang];
    });
    if (typeFilterLabel) typeFilterLabel.textContent = lang === "zh" ? "類型：" : "Type:";
    // 按鈕內已含多語 span，維持不動即可
  });
</script>

{% endblock %}
