{% extends "layout.njk" %}

{% block content %}

{# ===== 類型對照 ===== #}
{% set TYPE_ZH = {
  "Residential": "住宅",
  "Commercial": "商業",
  "Cultural": "文化",
  "Public": "公共",
  "Installation": "裝置",
  "Workshop": "工作營",
  "Exhibition": "展覽"
} %}
{% set TYPE_EN = {
  "住宅": "Residential",
  "商業": "Commercial",
  "文化": "Cultural",
  "公共": "Public",
  "裝置": "Installation",
  "工作營": "Workshop",
  "展覽": "Exhibition"
} %}

<style>
  /* ===============================
   * Projects page — clean overwrite
   * (no navbar/subnav rules here)
   * =============================== */

  /* Links inside each card */
  .project a { color: inherit; text-decoration: none; }
  .project a:hover { color: inherit; text-decoration: none; }

  /* ===== Responsive projects grid ===== */
  .projects-grid{
    max-width: 1000px;
    margin: 0 auto;
    padding: 1em 2.5em;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 2em;
    row-gap: 3em;
  }
  /* Narrow desktop */
  @media (max-width: 1024px){
    .projects-grid{
      padding: 1em 2.5em;
      grid-template-columns: repeat(3, 1fr);
      column-gap: 2em;
      row-gap: 3em;
    }
  }
  /* ===== Mobile: exactly ONE column (BIG.dk style) ===== */
  @media (max-width: 900px){
    .projects-grid{
      padding: 1em 2.5em;
      grid-template-columns: 1fr;     /* force single column */
      column-gap: 2em;                /* <-- fixed missing unit */
      row-gap: 4em;
    }
  }

  /* Card wrapper & thumbnail */
  .project-card{ display: block; color: inherit; border: none; padding: 0; }
  .project-thumb{
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border: none;
  }

  /* ===== Title (language-locked, stable height) =====
     - Desktop: reserve two lines
     - Mobile: reserve one line (most titles fit)
  */
  .project-title.lock-lang{
    position: relative;
    margin: .6em 0 0;
    font-weight: normal;
    color: #333;
    line-height: 1.25;
    font-size: 0.8em;
    min-height: calc(1em * 1 * 2);   /* two lines on desktop */
  }
  .project-title.lock-lang .lang-en,
  .project-title.lock-lang .lang-zh{
    position: absolute;
    inset: 0;
    display: flex; align-items: center; justify-content: center; /* center 1 or 2 lines */
    opacity: 0; visibility: hidden;
    max-height: calc(1em * 1 * 2);
    overflow: hidden;
    padding: 0 .25em;
    text-align: center;
    word-break: break-word;
  }
  .project-title.lock-lang .lang-en{ color: #444; }
  .project-title.lock-lang .lang-zh{ color: #555; }
  html[data-lang='en'] .project-title.lock-lang .lang-en{ opacity: 1; visibility: visible; }
  html[data-lang='zh'] .project-title.lock-lang .lang-zh{ opacity: 1; visibility: visible; }

  /* ===== Meta (no absolute positioning) =====
     - Toggle language by display
     - Keep compact by default (desktop)
  */
  .project-meta{
    margin-top: 0.2em;
    text-align: center;
    color: #666;
    font-variant-ligatures: none;
    min-height: 2em;                 /* room for two short lines */
  }
  .project-meta .project-meta-line{ margin-top: .15em; }

  .project-meta.lock-lang .lang-en,
  .project-meta.lock-lang .lang-zh{ display: none; }
  html[data-lang='en'] .project-meta.lock-lang .lang-en{ display: block; }
  html[data-lang='zh'] .project-meta.lock-lang .lang-zh{ display: block; }

  /* Meta sizes (desktop = 0.7em as requested) */
  .project-meta .lang-zh{ font-size: .7em; }
  .project-meta .lang-en{ font-size: .7em; opacity: .95; }

  /* ===== Mobile type ramp ===== */
  @media (max-width: 900px){
    /* Bigger titles on phones, but only reserve ONE line */
    .project-title.lock-lang{
      font-size: 1.15em;
      line-height: 1.3;
      min-height: calc(1.15em * 1.3);   /* one line height on mobile */
      margin-top: 0.8em;
    }
    .project-title.lock-lang .lang-en,
    .project-title.lock-lang .lang-zh{
      max-height: calc(1.15em * 1.3);   /* clamp to one line visually */
    }

    /* Slightly larger meta for readability */
    .project-meta{ margin-top: 0em; }
    .project-meta .lang-zh{ font-size: 0.85em; }
    .project-meta .lang-en{ font-size: 0.85em; }
  }
</style>

<section class="projects-page">
  <ul class="projects-grid project-grid">
    {% for project in collections.projects %}
      {% set d = project.data %}

      {# 類型/地點：標準化為英文，再反查中文 #}
      {% set rawType = d.type or '' %}
      {% set type_en = TYPE_EN[rawType] or rawType %}
      {% set type_zh = TYPE_ZH[type_en] or (TYPE_ZH[rawType] or rawType) %}
      {% set loc_en  = d.location_en or d.location or '' %}
      {% set loc_zh  = d.location_zh or d.location or '' %}

      {# 地區推論（taiwan / china / overseas） #}
      {% set _loc_zh = (loc_zh or '') | lower %}
      {% set _loc_en = (loc_en or '') | lower %}
      {% set region = '' %}
      {% if '台灣' in _loc_zh or '臺灣' in _loc_zh or 'taiwan' in _loc_en %}
        {% set region = 'taiwan' %}
      {% elif '中國' in _loc_zh or 'china' in _loc_en %}
        {% set region = 'china' %}
      {% else %}
        {% set region = 'overseas' %}
      {% endif %}

      {# 縮圖來源：優先 cover，其次 thumbnail，再退到第一張 gallery #}
      {% set rawImg = d.cover
                      or d.thumbnail
                      or (d.gallery and d.gallery[0] and (d.gallery[0].image or d.gallery[0]))
                      or (d.gallery_images and d.gallery_images[0]) %}
      {% set thumbSrc = rawImg | imageUrlSafe %}

      {# 面積/戶數（中英後綴） #}
      {% set _fa = d.floor_area %}
      {% set _un = d.units %}
      {% if _fa is not none %}
        {% set fa_str = (_fa ~ '') %}
        {% if ('㎡' in fa_str) or ('m²' in fa_str) or ('sqm' in (fa_str|lower)) %}
          {% set fa_en = fa_str %}{% set fa_zh = fa_str %}
        {% else %}
          {% set fa_en = fa_str ~ ' sqm' %}
          {% set fa_zh = fa_str ~ '㎡' %}
        {% endif %}
      {% endif %}
      {% if _un is not none %}
        {% set un_str = (_un ~ '') %}
        {% if ('戶' in un_str) or ('units' in (un_str|lower)) %}
          {% set units_en = un_str %}{% set units_zh = un_str %}
        {% else %}
          {% set units_en = un_str ~ ' units' %}
          {% set units_zh = un_str ~ '戶' %}
        {% endif %}
      {% endif %}

      <li class="project"
          data-year="{{ d.year }}"
          data-type="{{ type_en }}"
          data-type-en="{{ type_en }}"
          data-type-zh="{{ type_zh }}"
          data-location-en="{{ loc_en }}"
          data-location-zh="{{ loc_zh }}"
          data-region="{{ region }}">
        <a href="{{ project.url }}" class="project-card">
          {% if thumbSrc %}
            <img class="project-thumb"
                 src="{{ thumbSrc | safe }}"
                 alt="{{ d.title_en or d.title_zh }} — thumbnail"
                 loading="lazy" decoding="async"
                 referrerpolicy="no-referrer-when-downgrade">
          {% endif %}

          <div class="project-title lock-lang">
            <span class="lang-en">{{ d.title_en }}</span>
            <span class="lang-zh">{{ d.title_zh }}</span>
          </div>

          <div class="project-meta lock-lang">
            <div class="project-meta-line">
              <span class="lang-en">
                {% if type_en %}{{ type_en }}{% endif %}{% if loc_en %} ｜ {{ loc_en }}{% endif %}
              </span>
              <span class="lang-zh">
                {% if type_zh %}{{ type_zh }}{% endif %}{% if loc_zh %} ｜ {{ loc_zh }}{% endif %}
              </span>
            </div>
            <div class="project-meta-line">
              <span class="lang-en">
                {% if units_en %}{{ units_en }}{% endif %}{% if fa_en %} ｜ {{ fa_en }}{% endif %}{% if d.year %} ｜ {{ d.year }}{% endif %}
              </span>
              <span class="lang-zh">
                {% if units_zh %}{{ units_zh }}{% endif %}{% if fa_zh %} ｜ {{ fa_zh }}{% endif %}{% if d.year %} ｜ {{ d.year }}{% endif %}
              </span>
            </div>
          </div>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>

{% endblock %}
